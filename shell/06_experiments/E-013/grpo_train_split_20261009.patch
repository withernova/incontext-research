+def _replay_anchor(model, unwrapped_model, batch, records):
+    """先完成无梯度 anchor 重放，再切回 policy 创建训练图。"""
+    unwrapped_model.set_adapter("anchor")
+    model.eval()
+    with torch.no_grad():
+        anchor_log_probs = [
+            completion_logp(unwrapped_model, batch, row_record[0]).detach()
+            for row_record in records
+        ]
+        for index, record in enumerate(records):
+            counterfactual = record[5]
+            if counterfactual is not None:
+                positive_ref = completion_logp(
+                    unwrapped_model, batch, counterfactual["ids"]
+                ).detach()
+                counterfactual["anchor_positive"] = positive_ref[
+                    counterfactual["positive_mask"]
+                ].sum()
+                counterfactual["anchor_negative"] = anchor_log_probs[index][
+                    counterfactual["negative_mask"]
+                ].sum()
+    # anchor 重放完成后回到 policy，随后才能创建带梯度的前向。
+    unwrapped_model.set_adapter("policy")
+    model.train()
+    return anchor_log_probs
+
