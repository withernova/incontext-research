+def _backward_and_log(
+    config,
+    counterfactual_config,
+    counterfactual_weight,
+    model,
+    world_size,
+    batch,
+    row,
+    records,
+    anchor_log_probs,
+    advantages,
+    row_index,
+    pair_size,
+    step,
+    log,
+):
+    """累积一个条件的梯度并写逐样本记录；仅整个 pair 最后一次 backward 同步。"""
+    diagnostics = []
+    for index, (
+        generated_ids,
+        text,
+        terminated,
+        reward,
+        old_log_probs,
+        counterfactual,
+        counterfactual_status,
+    ) in enumerate(records):
+        # DDP 仅在该 pair 的最后一次 backward 同步，前面的梯度仍累积。
+        sync = row_index == pair_size - 1 and index == len(records) - 1
+        context = model.no_sync() if world_size > 1 and not sync else nullcontext()
+        with context:
+            current_log_probs = completion_logp(model, batch, generated_ids)
+            if not torch.allclose(
+                current_log_probs.detach(),
+                old_log_probs,
+                atol=0.02,
+                rtol=0.002,
+            ):
+                raise RuntimeError("old-policy replay mismatch before optimizer update")
+            grpo_objective_loss = grpo_loss(
+                current_log_probs,
+                old_log_probs,
+                anchor_log_probs[index],
+                advantages[index],
+                beta=config.get("beta", 0.04),
+                clip=config.get("clip", 0.2),
+            )
+            counterfactual_loss = None
+            if counterfactual is not None:
+                positive_logp = completion_logp(model, batch, counterfactual["ids"])
+                counterfactual_loss = score_preference_loss(
+                    positive_logp[counterfactual["positive_mask"]].sum(),
+                    current_log_probs[counterfactual["negative_mask"]].sum(),
+                    counterfactual["anchor_positive"],
+                    counterfactual["anchor_negative"],
+                    beta=counterfactual_config.get("beta", 0.1),
+                )
+            combined = grpo_objective_loss + (
+                counterfactual_weight * counterfactual_loss
+                if counterfactual_loss is not None
+                else 0.0
+            )
+            # 保持原有缩放：先平均同输入的 G 次采样，再平均 pair 的条件。
+            (combined / (pair_size * config["group_size"])).backward()
+        item = dict(
+            step=step,
+            sample_id=row["id"],
+            training_source=row.get("training_source", "original"),
+            target_present=row["target_present"],
+            text=text,
+            terminated=terminated,
+            reward=reward,
+            advantage=float(advantages[index]),
+            loss=float(grpo_objective_loss.detach()),
+            cf_applied=counterfactual is not None,
+            cf_status=counterfactual_status,
+            cf_loss=float(counterfactual_loss.detach())
+            if counterfactual_loss is not None
+            else None,
+            cf_reward_gain=counterfactual["reward_gain"]
+            if counterfactual is not None
+            else None,
+            completion_tokens=generated_ids.shape[1] - batch["input_ids"].shape[1],
+        )
+        log.write(json.dumps(item) + "\n")
+        diagnostics.append(item)
+    return diagnostics
+
