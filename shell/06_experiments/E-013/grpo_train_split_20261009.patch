+"""Exercise train orchestration on CPU, with synthetic prompts and no model assets."""
+import json
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from iploc_szy.rl import trainer
+
+
+@pytest.mark.parametrize('epochs', [None, 2])
+def test_train_updates_logs_and_saves_in_order(tmp_path, monkeypatch, epochs):
+    events = []
+
+    class Policy(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.weight = torch.nn.Parameter(torch.tensor(0.2))
+            self.adapter = 'policy'
+
+        def set_adapter(self, adapter):
+            self.adapter = adapter
+            events.append(adapter)
+
+        def save_pretrained(self, directory, **kwargs):
+            directory.mkdir(parents=True)
+            events.append(('save', str(directory)))
+
+    model = Policy()
+    processor = SimpleNamespace(save_pretrained=lambda directory: directory.mkdir())
+    rows = [dict(id='positive', pair_id='pair', target_present=True),
+            dict(id='negative', pair_id='pair', target_present=False)]
+    monkeypatch.setattr(trainer, 'inspect_config', lambda config: rows)
+    monkeypatch.setattr(trainer, 'load_policy', lambda config: (model, processor))
+    # Avoid consulting launch environment or initializing CUDA for this synthetic run.
+    monkeypatch.setattr(trainer.os, 'environ', {})
+    actual_device = torch.device
+    monkeypatch.setattr(trainer.torch, 'device', lambda spec: actual_device('cpu'))
+    monkeypatch.setattr(trainer, 'prepare_prompt', lambda *args, **kwargs:
+                        (dict(input_ids=torch.tensor([[1 if args[0]["target_present"] else 5, 2]])),
+                         [0, 0, 10, 10] if args[0]['target_present'] else None))
+    generated = 0
+
+    def rollout(*args):
+        nonlocal generated
+        generated += 1
+        token = 3 + generated % 2
+        score = '0.80' if token == 4 else '0.20'
+        return torch.tensor([[1, 2, token]]), f'<answer>[0,0,10,10]</answer><score>{score}</score>', True
+
+    def log_probs(policy, batch, ids):
+        events.append(('replay', policy.adapter, torch.is_grad_enabled()))
+        scale = float(ids[0, -1]) * float(batch["input_ids"][0, 0])
+        return (policy.weight * scale).reshape(1)
+
+    monkeypatch.setattr(trainer, 'rollout', rollout)
+    monkeypatch.setattr(trainer, 'completion_logp', log_probs)
+    manifest = tmp_path / 'manifest.jsonl'
+    manifest.write_text('synthetic')
+    output = tmp_path / 'output'
+    config = dict(manifest=str(manifest), output_dir=str(output), seed=1,
+                  steps=1, epochs=epochs, group_size=2, max_pixels=10,
+                  max_new_tokens=3, learning_rate=0.01, beta=0.04)
+    before = model.weight.detach().clone()
+    trainer.train(config)
+
+    expected_steps = epochs or 1
+    records = [json.loads(line) for line in (output / 'rollouts-rank0.jsonl').read_text().splitlines()]
+    assert len(records) == 4 * expected_steps
+    assert all(record['reward']['valid'] for record in records)
+    assert all(record['cf_status'] == 'not_eligible' for record in records)
+    assert not torch.equal(before, model.weight.detach())
+    completed = json.loads((output / 'completed.json').read_text())
+    assert completed['steps'] == expected_steps
+    assert completed['counterfactual_pairs'] == 0
+    saved = torch.load(output / 'optimizer.pt', weights_only=False)
+    assert saved['steps'] == expected_steps
+    assert all(not event[2] for event in events if isinstance(event, tuple) and event[:2] == ('replay', 'anchor'))
+    # Each condition completes both anchor passes before either differentiable policy pass.
+    replays = [event[1:] for event in events if isinstance(event, tuple) and event[0] == 'replay']
+    expected_condition = [('policy', False)] * 2 + [('anchor', False)] * 2 + [('policy', True)] * 2
+    assert replays == expected_condition * (2 * expected_steps)
