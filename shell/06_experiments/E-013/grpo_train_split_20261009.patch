+def _collect_rollouts(
+    config,
+    counterfactual_config,
+    counterfactual_weight,
+    unwrapped_model,
+    processor,
+    batch,
+    row,
+    target_box,
+):
+    """采样并冻结 old-policy log-prob；附带满足奖励与 token 对齐门禁的反事实。"""
+    records = []
+    for _ in range(config["group_size"]):
+        generated_ids, text, terminated = rollout(
+            unwrapped_model, processor, batch, config["max_new_tokens"]
+        )
+        reward_fn = confidence_reward
+        if config.get("prompt_protocol") in (
+            "focus_multi3_instances_v1",
+            "focus_multi3_instances_spatial_v2",
+        ):
+            from .multi_candidate import multi_reward
+
+            reward_fn = multi_reward
+        reward_args = dict(config.get("reward", {}))
+        if row.get("distractor_box") is not None:
+            reward_args["distractor_box"] = normalize_box(
+                row["distractor_box"], row["query_canvas_size"]
+            )
+        if row.get("coverage_boxes") is not None:
+            reward_args["coverage_boxes"] = [
+                normalize_box(box, row["query_canvas_size"])
+                for box in row["coverage_boxes"]
+            ]
+        reward = reward_fn(
+            text,
+            target_present=row["target_present"],
+            gt_box=target_box,
+            terminated=terminated,
+            **reward_args,
+        )
+        counterfactual = None
+        counterfactual_status = "not_eligible"
+        # 反事实只交换 score；仅 reward 提升且 token 对齐通过时加入偏好项。
+        if counterfactual_weight > 0 and row["target_present"] and reward.get("valid"):
+            positive_text = corrected_score_text(
+                text,
+                reward,
+                rank_iou_delta=reward_args.get("rank_iou_delta", 0.1),
+                min_best_iou=counterfactual_config.get("min_best_iou", 0.5),
+            )
+            if positive_text is not None:
+                counterfactual_status = "reward_not_improved"
+                positive_reward = reward_fn(
+                    positive_text,
+                    target_present=True,
+                    gt_box=target_box,
+                    terminated=True,
+                    **reward_args,
+                )
+                gain = positive_reward["total"] - reward["total"]
+                if gain > counterfactual_config.get("min_reward_gain", 0.0):
+                    aligned = counterfactual_ids_and_masks(
+                        processor.tokenizer,
+                        batch["input_ids"],
+                        generated_ids,
+                        text,
+                        positive_text,
+                        config["max_new_tokens"],
+                    )
+                    counterfactual_status = "token_budget"
+                    if aligned is not None:
+                        positive_ids, positive_mask, negative_mask = aligned
+                        counterfactual = dict(
+                            ids=positive_ids,
+                            positive_mask=positive_mask,
+                            negative_mask=negative_mask,
+                            reward_gain=gain,
                         )
-                        / len(diagnostics),
-                    )
-                ),
-                flush=True,
-            )
-            # 中间 checkpoint 由 rank 0 写入；本轮保持原保存布局与时间点。
-            if (step + 1) % config.get("save_every_steps", 50) == 0 or (
-                step + 1
-            ) % steps_per_epoch == 0:
