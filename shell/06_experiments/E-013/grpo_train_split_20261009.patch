+def _train_pair(
+    config,
+    counterfactual_config,
+    counterfactual_weight,
+    model,
+    unwrapped_model,
+    processor,
+    device,
+    world_size,
+    training_pair,
+    step,
+    log,
+):
+    """按输入顺序训练 pair 的各条件，保持每个条件内部的优势标准化。"""
+    diagnostics = []
+    for row_index, row in enumerate(training_pair):
+        unwrapped_model.eval()
+        batch, target_box = prepare_prompt(
+            row,
+            processor,
+            device,
+            config["max_pixels"],
+            protocol=config.get("prompt_protocol", "focus_confidence"),
+        )
+        # old-policy log-prob 在参数更新前冻结，用于比率及重放一致性检查。
+        records = _collect_rollouts(
+            config,
+            counterfactual_config,
+            counterfactual_weight,
+            unwrapped_model,
