+def _initialize_policy(config, counterfactual_weight, seed):
+    """统一模型初始化 seed，随后设置 rank 采样 seed 并建立 optimizer。"""
+    # 模型初始化使用公共 seed；加载完成后才设置各 rank 的采样 seed。
+    random.seed(seed)
+    torch.manual_seed(seed)
+    torch.cuda.manual_seed_all(seed)
+    model, processor = load_policy(config)
+    if counterfactual_weight > 0:
+        probe = "\n".join(
+            "<answer>[{0},{0},{1},{1}]</answer><score>{2}</score>".format(
+                10 * i, 10 * i + 5, score
+            )
+            for i, score in enumerate(("0.80", "0.05", "0.01"))
+        )
+        score_tokenization(processor.tokenizer, probe)
+    rank = int(os.environ.get("LOCAL_RANK", 0))
+    world_size = int(os.environ.get("WORLD_SIZE", 1))
+    unwrapped_model = model.module if hasattr(model, "module") else model
+    torch.manual_seed(seed + rank)
+    torch.cuda.manual_seed_all(seed + rank)
+    device = torch.device(f"cuda:{rank}")
+    trainable_parameters = [
+        parameter for parameter in model.parameters() if parameter.requires_grad
+    ]
+    optimizer = torch.optim.AdamW(
+        trainable_parameters, lr=config.get("learning_rate", 1e-6)
+    )
+    return (
+        model,
+        processor,
+        rank,
+        world_size,
+        unwrapped_model,
+        device,
+        trainable_parameters,
+        optimizer,
+    )
