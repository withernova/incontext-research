+def _plan_training_pairs(rows, config, seed, world_size):
+    """构建 pair 与训练步数；保留原顺序、固定重排和尾部循环补齐规则。"""
+    # 按 pair_id 保留输入顺序。每个条件内部独立标准化 GRPO 优势。
+    groups = defaultdict(list)
+    for row_record in rows:
+        groups[row_record["pair_id"]].append(row_record)
+    pairs = list(groups.values())
+    if len(pairs) < world_size:
+        raise ValueError("fewer pairs than GPU ranks")
+    # 每个 epoch 按固定 seed 重排 pair；尾部按原实现循环补齐 rank 配额。
+    epochs = config.get("epochs")
+    steps_per_epoch = (len(pairs) + world_size - 1) // world_size
+    total_steps = steps_per_epoch * epochs if epochs is not None else config["steps"]
+    step_pairs = list(pairs) if epochs is None else None
+    if step_pairs is not None:
+        random.Random(seed).shuffle(step_pairs)
+    return pairs, epochs, steps_per_epoch, total_steps, step_pairs
