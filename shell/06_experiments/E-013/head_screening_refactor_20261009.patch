+"""target_background.inputs：独立职责模块；原实验入口保留兼容导入。"""
+from __future__ import annotations
+
+import hashlib
+import json
+from collections import Counter
+from pathlib import Path
+from typing import Mapping
+import numpy as np
+from ...prompting.coordinates import parse_box
+from ..bbox_gradient import sequence_keys
+
+
+def _checked_file(path, digest):
+    if not path or not isinstance(digest, str) or len(digest) != 64:
+        raise ValueError("an explicit path and SHA-256 digest are required")
+    content = Path(path).read_bytes()
+    if hashlib.sha256(content).hexdigest() != digest:
+        raise ValueError(f"SHA-256 mismatch: {path}")
+    return content
+
+
+def load_frozen_selectors(
+    path, digest, selector_names, expected_layers, expected_heads
+):
+    """Load and validate the R-005 frozen selector lists without re-ranking."""
+    payload = json.loads(_checked_file(path, digest))
+    if not isinstance(payload, Mapping):
+        raise ValueError("frozen_heads.json must be a JSON object")
+    selectors = {}
+    for name in selector_names:
+        items = payload.get(str(name))
+        if not isinstance(items, list) or not items:
+            raise ValueError(f"frozen selector {name} is missing or empty")
+        heads = []
+        for expected_rank, item in enumerate(items, 1):
+            if not isinstance(item, Mapping):
+                raise ValueError(f"frozen selector {name} entries must be mappings")
+            layer, head = item.get("layer"), item.get("head")
+            if type(layer) is not int or type(head) is not int:
+                raise ValueError(f"frozen selector {name} needs integer layer/head")
+            if item.get("rank") != expected_rank:
+                raise ValueError(f"frozen selector {name} ranks must be 1..N in order")
+            if not (0 <= layer < expected_layers and 0 <= head < expected_heads):
+                raise ValueError(
+                    f"frozen selector {name} head outside model dimensions"
+                )
+            heads.append((layer, head))
+        if len(set(heads)) != len(heads):
+            raise ValueError(f"frozen selector {name} contains duplicate heads")
+        selectors[str(name)] = heads
+    return selectors
+
+
+def same_layer_random_heads(reference_heads, forbidden, width, seed):
+    """Draw same-layer, same-count control heads excluding every frozen head."""
+    counts = Counter(layer for layer, _ in reference_heads)
+    rng = np.random.default_rng(int(seed))
+    chosen = []
+    for layer in sorted(counts):
+        pool = np.asarray(
+            [h for h in range(int(width)) if (layer, h) not in forbidden],
+            dtype=np.int64,
+        )
+        if pool.size < counts[layer]:
+            raise ValueError("insufficient same-layer non-frozen control heads")
+        picked = rng.choice(pool, size=int(counts[layer]), replace=False)
+        chosen.extend((int(layer), int(h)) for h in sorted(map(int, picked.tolist())))
+    if len(chosen) != len(reference_heads):
+        raise ValueError("random control head count differs from its reference set")
+    return chosen
+
+
+def build_head_groups(
+    selectors,
+    selector_names,
+    top_ks,
+    per_head_top_k,
+    random_match_selectors,
+    random_seeds,
+    per_head_random_seeds,
+    expected_layers,
+    expected_heads,
+):
+    """Resolve set, per-head and same-layer random control groups.
+
+    Identical head sets shared by several selectors are collapsed into one
+    intervention group whose ``selectors`` field lists every alias, so coverage
+    is explicit without running the same tensor work twice.  Set controls are
+    matched to the frozen set size; every per-head candidate gets a single-head
+    same-layer random control so a one-head verdict is never compared against a
+    whole-set estimand.
+    """
+    frozen_union = set()
+    for name in selector_names:
+        frozen_union.update(selectors[str(name)])
+    top_ks = sorted(int(value) for value in top_ks)
+    if not top_ks or any(value < 1 for value in top_ks):
+        raise ValueError("set_top_ks must be positive integers")
+    if not 1 <= int(per_head_top_k):
+        raise ValueError("per_head_top_k must be a positive integer")
+
+    groups, by_heads = [], {}
+    for name in selector_names:
+        name = str(name)
+        for k in top_ks:
+            heads = tuple(selectors[name][:k])
+            if not heads:
+                raise ValueError(f"{name} has no heads for top-{k}")
+            key = tuple(sorted(heads))
+            existing = by_heads.get(key)
+            if existing is not None:
+                if name not in existing["selectors"]:
+                    existing["selectors"].append(name)
+                if k not in existing["top_k"]:
+                    existing["top_k"].append(k)
+                continue
+            group = {
+                "name": f"{name}_top{k}",
+                "kind": "set",
+                "selectors": [name],
+                "top_k": [k],
+                "heads": [list(head) for head in heads],
+            }
+            by_heads[key] = group
+            groups.append(group)
+
+    per_head = set()
+    for name in selector_names:
+        per_head.update(selectors[str(name)][: int(per_head_top_k)])
+    for layer, head in sorted(per_head):
+        groups.append(
+            {
+                "name": f"head_L{layer:02d}H{head:02d}",
+                "kind": "head",
+                "selectors": [],
+                "top_k": [],
+                "heads": [[int(layer), int(head)]],
+            }
+        )
+
+    for name in random_match_selectors:
+        name = str(name)
+        if name not in selectors:
+            raise ValueError(
+                f"random_match_selectors refers to an unknown selector: {name}"
+            )
+        for k in top_ks:
+            reference = selectors[name][:k]
+            for seed in random_seeds:
+                heads = same_layer_random_heads(
+                    reference, frozen_union, expected_heads, seed
+                )
+                groups.append(
+                    {
+                        "name": f"random_{name}_seed{int(seed)}_top{k}",
+                        "kind": "random",
+                        "selectors": [name],
+                        "top_k": [k],
+                        "seed": int(seed),
+                        "heads": [list(head) for head in heads],
+                    }
+                )
+    for layer in sorted({int(layer) for layer, _ in per_head}):
+        for seed in per_head_random_seeds:
+            pool = np.asarray(
+                [
+                    h
+                    for h in range(int(expected_heads))
+                    if (layer, h) not in frozen_union
+                ],
+                dtype=np.int64,
+            )
+            if pool.size < 1:
+                raise ValueError(
+                    "no same-layer non-frozen single-head control available"
+                )
+            chosen = int(
+                np.random.default_rng(int(seed) + 1000 * layer).choice(
+                    pool, 1, replace=False
+                )[0]
+            )
+            groups.append(
+                {
+                    "name": f"random_single_L{layer:02d}_seed{int(seed)}",
+                    "kind": "random",
+                    "selectors": [],
+                    "top_k": [],
+                    "seed": int(seed),
+                    "heads": [[layer, chosen]],
+                }
+            )
+    for group in groups:
+        for layer, head in map(tuple, group["heads"]):
+            if not (0 <= layer < expected_layers and 0 <= head < expected_heads):
+                raise ValueError(
+                    f"{group['name']} head outside expected model dimensions"
+                )
+        if len(set(map(tuple, group["heads"]))) != len(group["heads"]):
+            raise ValueError(f"{group['name']} repeats a head")
+    return groups
+
+
+def target_size_bin(answer, boundaries):
+    box = parse_box(answer)
+    if box is None:
+        raise ValueError("cannot parse normalized bbox for size stratum")
+    x1, y1, x2, y2 = box
+    if not (0 <= x1 < x2 <= 1000 and 0 <= y1 < y2 <= 1000):
+        raise ValueError("bbox must be valid normalized xyxy in [0,1000]")
+    area = max(0.0, x2 - x1) * max(0.0, y2 - y1) / 1_000_000.0
+    lower, upper = map(float, boundaries)
+    if not 0 < lower < upper < 1:
+        raise ValueError("target size boundaries must satisfy 0 < lower < upper < 1")
+    return "small" if area < lower else "medium" if area < upper else "large"
+
+
+def build_causal_assignments(dataset, counts, required, r005_assignments):
+    """Freeze a sequence/image-disjoint Causal split that avoids every R-005 row."""
+    if not isinstance(counts, Mapping) or not counts:
+        raise ValueError("causal_split_counts must be a non-empty dataset mapping")
+    requested = {}
+    for key, value in counts.items():
+        if type(value) is not int or value < 1:
+            raise ValueError(
+                "each causal_split_counts value must be a positive integer"
+            )
+        requested[str(key)] = int(value)
+    r005_indices, r005_images, r005_components = set(), set(), set()
+    for row in r005_assignments:
+        r005_indices.add(int(row["dataset_index"]))
+        r005_components.add(str(row["component_id"]))
+        r005_images.update(str(value) for value in row["image_ids"])
+    if r005_indices and max(r005_indices) >= len(dataset):
+        raise ValueError("frozen R-005 dataset index is outside the current manifest")
+    r005_sequences = set()
+    for index in sorted(r005_indices):
+        r005_sequences |= sequence_keys(dataset[index]["raw"])
+
+    training_path = Path(str(required["training_manifest"])).resolve()
+    if hashlib.sha256(training_path.read_bytes()).hexdigest() != str(
+        required["training_manifest_sha256"]
+    ):
+        raise ValueError("training manifest SHA-256 mismatch")
+    training = json.loads(training_path.read_text())
+    seen_training = set().union(*(sequence_keys(record) for record in training))
+
+    pools = {name: [] for name in requested}
+    excluded_training = excluded_invalid = excluded_r005 = 0
+    for index in range(len(dataset)):
+        sample = dataset[index]
+        raw = sample["raw"]
+        name = str(raw.get("dataset"))
+        if name not in pools:
+            continue
+        keys = sequence_keys(raw)
+        if keys & seen_training:
+            excluded_training += 1
+            continue
+        images = tuple(map(str, sample["image_paths"]))
+        if len(images) != 2 or len(set(images)) != 2:
+            raise ValueError("R-008 requires one distinct Reference and Query image")
+        if (
+            index in r005_indices
+            or (keys & r005_sequences)
+            or (set(images) & r005_images)
+        ):
+            excluded_r005 += 1
+            continue
+        references = sample.get("reference_answers")
+        try:
+            if not isinstance(references, list) or len(references) != 1:
+                raise ValueError("R-008 requires exactly one Reference bbox")
+            target_size_bin(references[0], required["target_size_area_boundaries"])
+            size_bin = target_size_bin(
+                sample["query_answer"], required["target_size_area_boundaries"]
+            )
+        except ValueError:
+            excluded_invalid += 1
+            continue
+        pools[name].append((index, sample, keys, images, size_bin))
+
+    rng = np.random.default_rng(int(required["causal_selection_seed"]))
+    assignments, used_sequences, used_images = [], set(), set()
+    for name in sorted(requested):
+        chosen = []
+        for position in rng.permutation(len(pools[name])):
+            index, sample, keys, images, size_bin = pools[name][int(position)]
+            if keys & used_sequences or (set(images) & used_images):
+                continue
+            chosen.append((index, sample, keys, images, size_bin))
+            used_sequences.update(keys)
+            used_images.update(images)
+            if len(chosen) == requested[name]:
+                break
+        if len(chosen) != requested[name]:
+            raise ValueError(
+                f"insufficient disjoint Causal samples for {name}: "
+                f"wanted {requested[name]}, got {len(chosen)}"
+            )
+        for index, sample, keys, images, size_bin in chosen:
+            identity = json.dumps(
+                {
+                    "dataset": name,
+                    "sequences": sorted(map(list, keys)),
+                    "images": images,
+                },
+                sort_keys=True,
+            )
+            assignments.append(
+                {
+                    "dataset_index": int(index),
+                    "sample_id": str(sample["id"]),
+                    "split": "causal",
+                    "dataset": name,
+                    "component_id": hashlib.sha256(identity.encode()).hexdigest(),
+                    "image_ids": list(images),
+                    "target_size_bin": size_bin,
+                }
+            )
+
+    audit = {
+        "training_manifest": str(training_path),
+        "training_manifest_sha256": str(required["training_manifest_sha256"]),
+        "training_sequence_count": len(seen_training),
+        "excluded_training_rows": excluded_training,
+        "excluded_invalid_box_rows": excluded_invalid,
+        "excluded_r005_rows": excluded_r005,
+        "r005_rows": len(r005_indices),
+        "requested_per_dataset": requested,
+        "selected_per_dataset": {
+            name: sum(row["dataset"] == name for row in assignments)
+            for name in sorted(requested)
+        },
+    }
+    validate_causal_assignments(assignments, r005_indices, r005_images, r005_components)
+    return assignments, audit
+
+
+def validate_causal_assignments(
+    assignments, r005_indices, r005_images, r005_components
+):
+    if not assignments:
+        raise ValueError("Causal split must be non-empty")
+    samples, components, images, indices = set(), {}, set(), set()
+    for row in assignments:
+        sample = str(row.get("sample_id") or "")
+        component = str(row.get("component_id") or "")
+        index = int(row["dataset_index"])
+        if not sample or not component or row.get("split") != "causal":
+            raise ValueError(
+                "Causal rows need sample_id, component_id and split=causal"
+            )
+        if sample in samples or index in indices:
+            raise ValueError("Causal rows must have unique sample_id and dataset_index")
+        samples.add(sample)
+        indices.add(index)
+        components.setdefault(component, index)
+        for image in map(str, row.get("image_ids") or []):
+            if image in images:
+                raise ValueError("Causal images must be unique across rows")
+            images.add(image)
+    if indices & set(r005_indices):
+        raise ValueError("Causal and R-005 dataset indices overlap")
+    if images & set(r005_images):
+        raise ValueError("Causal and R-005 images overlap")
+    if set(components) & set(r005_components):
+        raise ValueError("Causal and R-005 components overlap")
+    return len(assignments)
+
+
+def _kind(groups, name):
+    for group in groups:
+        if group["name"] == name:
+            return group["kind"]
+    raise ValueError(f"unknown group {name}")
+
+
+def _did_candidate_names(required, groups):
+    """Add every frozen per-head candidate when per-head controls are requested."""
+    names = [str(value) for value in required["did_candidates"]]
+    if bool(required["did_include_per_head_controls"]):
+        names += [group["name"] for group in groups if group["kind"] == "head"]
+    if not names:
+        raise ValueError("at least one DiD candidate is required")
+    return tuple(names)
+
+
+def _resolve_did_pairs(required, groups):
+    """Pair frozen candidates with their frozen and same-layer random controls.
+
+    Set candidates are compared with the frozen legacy / high-gradient-only sets
+    plus the same-top-k random sets.  A single-head candidate is compared only
+    with single-head same-layer random controls, never with a whole-set effect.
+    """
+    by_name = {group["name"]: group for group in groups}
+    random_names = sorted(
+        group["name"] for group in groups if group["kind"] == "random"
+    )
