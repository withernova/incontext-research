-                    mask, detail = attention_mass_matched_mask(
-                        attention_mass[head], g, tolerance=required["background_attention_tolerance"])
-                    audits.append(detail)
-                    if mask is None:
-                        feasible = False
-                        rows = None
-                        break
-                    rows.append(mask)
-                masks = np.stack(rows) if feasible else None
