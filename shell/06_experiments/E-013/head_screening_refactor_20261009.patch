+            json.dumps(
+                dict(
+                    schema=plan["schema"],
+                    sample_count=plan["sample_count"],
+                    image_role=plan["image_role"],
+                    condition_grid=plan["condition_grid"],
+                    intervention=plan.get("intervention"),
+                    row_scopes=plan.get("row_scopes"),
+                    keep_groups=plan["keep_groups"],
+                    conditions=[condition["name"] for condition in plan["conditions"]],
+                    condition_integrity=condition_integrity(plan),
+                ),
+                ensure_ascii=False,
+                indent=2,
+            )
+        )
+        return
+    manifest = hashlib.sha256(
+        json.dumps(
+            [
+                (
+                    condition["name"],
+                    [list(map(int, pair)) for pair in condition["heads"]],
+                )
+                for condition in plan["conditions"]
+            ],
+            sort_keys=True,
+        ).encode()
+    ).hexdigest()
+    print(
+        f"[KEEPSET_PRUNING] conditions={len(plan['conditions'])} plan_sha256={manifest}",
+        flush=True,
+    )
+    execute(plan, snapshots)
