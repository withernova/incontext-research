+    for candidate in map(str, required["did_candidates"]):
+        if candidate not in by_name:
+            raise ValueError(f"DiD candidate group is missing: {candidate}")
+        group = by_name[candidate]
+        if group["kind"] == "head":
+            layer = int(group["heads"][0][0])
+            controls = [
+                name
+                for name in random_names
+                if name.startswith(f"random_single_L{layer:02d}_seed")
+            ]
+        else:
+            top_ks = sorted({int(value) for value in group["top_k"]})
+            controls = list(map(str, required["did_controls"]))
+            controls += [
+                name
+                for name in random_names
+                if any(name.endswith(f"_top{k}") for k in top_ks)
+            ]
+        for control in controls:
+            if control not in by_name:
+                raise ValueError(f"DiD control group is missing: {control}")
+            if control == candidate or (candidate, control) in seen:
+                continue
+            seen.add((candidate, control))
+            pairs.append((candidate, control))
+    if not pairs:
+        raise ValueError(
+            "did_candidates/did_controls resolved to no comparable frozen groups"
+        )
+    return pairs
