-def attention_mass_matched_mask(attention, target_mask, *, tolerance):
-    """Greedy fractional background mask matching the target's removed attention mass."""
-    a = np.asarray(attention, dtype=np.float64).reshape(-1)
-    t = _finite_mask(target_mask, "target_mask").reshape(-1)
-    if a.shape != t.shape or a.size == 0:
-        raise ValueError("attention mass and target mask must share one non-empty shape")
-    if not np.isfinite(a).all() or np.any(a < 0):
-        raise ValueError("attention mass must be finite and non-negative")
-    target_mass = float((a * t).sum())
-    if target_mass <= 0:
-        raise ValueError("target removed attention mass must be positive")
-    capacity = np.where(t > 0, 0.0, a)
-    available = float(capacity.sum())
-    if available + 1e-12 < target_mass:
-        return None, {"feasible": False, "target_mass": target_mass,
-                      "available_mass": available, "removed_mass": None,
-                      "relative_error": None}
-    mask = np.zeros_like(a)
-    remaining = target_mass
-    for index in np.argsort(-capacity, kind="stable"):
-        if remaining <= 1e-12:
-            break
-        if capacity[index] <= 0:
-            continue
-        take = min(float(capacity[index]), remaining)
-        mask[index] = min(1.0, take / float(a[index]))
-        remaining -= take
-    removed = float((a * mask).sum())
-    error = abs(removed - target_mass) / target_mass
-    if error > float(tolerance):
-        return None, {"feasible": False, "target_mass": target_mass, "available_mass": available,
-                      "removed_mass": removed, "relative_error": error}
-    return mask, {"feasible": True, "target_mass": target_mass, "available_mass": available,
-                  "removed_mass": removed, "relative_error": error}
-
