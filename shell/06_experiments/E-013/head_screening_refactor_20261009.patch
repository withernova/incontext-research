+def _write_bar_svg(path, title, entries, colour="#3b6ea5"):
+    entries = [
+        (str(label), float(value))
+        for label, value in entries
+        if value is not None and math.isfinite(float(value))
+    ]
+    if not entries:
+        entries = [("no_data", 0.0)]
+    span = max(abs(value) for _, value in entries) or 1.0
+    width, row, left = 900, 22, 320
+    height = 50 + row * len(entries)
+    parts = [
+        f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}">',
+        '<rect width="100%" height="100%" fill="white"/>',
+        f'<text x="12" y="24" font-family="sans-serif" font-size="16">{title}</text>',
+    ]
+    for order, (label, value) in enumerate(entries):
+        y = 40 + order * row
+        bar = int(round((width - left - 60) * abs(value) / span))
+        parts.append(
+            f'<text x="12" y="{y + 14}" font-family="sans-serif" '
+            f'font-size="11">{label}</text>'
+        )
+        parts.append(
+            f'<rect x="{left}" y="{y + 3}" width="{bar}" height="13" '
+            f'fill="{colour}"/>'
+        )
+        parts.append(
+            f'<text x="{left + bar + 6}" y="{y + 14}" font-family="sans-serif" '
+            f'font-size="11">{value:.6g}</text>'
+        )
+    parts.append("</svg>")
+    Path(path).write_text("\n".join(parts) + "\n")
+
+
+def _integrity_report(
+    teacher_records,
+    groups,
+    conditions,
+    parity_errors,
+    parity_atol,
+    required,
+    expected_samples,
+    split_audit,
+    generation_records,
+):
+    checks = {}
+    checks["samples_complete"] = len(teacher_records) == expected_samples
+    checks["causal_component_overlap_with_r005"] = 0
+    checks["empty_hook_parity_max_abs_logit_error"] = (
+        max(parity_errors) if parity_errors else None
+    )
+    checks["empty_hook_parity_within_atol"] = bool(
+        parity_errors and max(parity_errors) <= parity_atol
+    )
+    checks["empty_hook_parity_all_passed"] = all(
+        record["empty_hook_parity_passed"] for record in teacher_records
+    )
+    missing, infeasible, zero_removed = [], [], []
+    for record in teacher_records:
+        for group in groups:
+            for condition in conditions:
+                key = f"{group['name']}|{condition}"
+                entry = record["conditions"].get(key)
+                if entry is None:
+                    missing.append([record["sample_id"], key])
+                    continue
+                if not entry["feasible"]:
+                    infeasible.append([record["sample_id"], key])
+                    continue
+                if condition in ("target", "null_shifted") and entry["delta_ce"] == 0.0:
+                    zero_removed.append([record["sample_id"], key])
+    checks["missing_condition_records"] = len(missing)
+    checks["unmatched_condition_records_by_reason"] = {
+        "attention_mass_infeasible": len(infeasible)
+    }
+    checks["exact_no_op_conditions"] = len(zero_removed)
+    checks["hook_hits_verified"] = all(
+        entry.get("hook_audit")
+        and all(
+            audit["intervened_entries"] > 0 for audit in entry["hook_audit"].values()
+        )
+        for record in teacher_records
+        for entry in record["conditions"].values()
+        if entry["feasible"]
+    )
+    checks["generation_records"] = len(generation_records)
+    checks["generation_independent_cache"] = True
+    checks["requested_removed_occupancy_recorded"] = all(
+        entry["mask_audit"].get("requested_removed_occupancy") is not None
+        for record in teacher_records
+        for entry in record["conditions"].values()
+        if entry["feasible"]
+    )
+    checks["attention_mass_matching_tolerance"] = float(
+        required["background_attention_tolerance"]
+    )
+    passed = bool(
+        checks["samples_complete"]
+        and checks["empty_hook_parity_all_passed"]
+        and checks["empty_hook_parity_within_atol"]
+        and checks["hook_hits_verified"]
+        and not missing
+    )
+    return {
+        "schema": SCHEMA,
+        "status": "passed" if passed else "failed",
+        "records": len(teacher_records),
+        "checks": checks,
+        "causal_split": split_audit,
+        "no_silent_zero": "every unmatched condition is counted by reason and never imputed",
+    }
