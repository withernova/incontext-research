+    parser.add_argument("--recompute", metavar="OUTPUT_DIR")
+    parser.add_argument("--validate-only", action="store_true")
+    args = parser.parse_args(argv)
+    if args.recompute:
+        result = recompute(args.recompute)
+        print(
+            json.dumps(
+                dict(records=result["records"], verdicts=result["verdicts"]),
+                ensure_ascii=False,
+                indent=2,
+            )
+        )
+        return
+    if not args.config:
+        parser.error("config is required unless --recompute is used")
+    spec = Config.fromfile(args.config)["run_spec"]
+    plan, snapshots = validate_spec(spec)
+    if args.validate_only:
