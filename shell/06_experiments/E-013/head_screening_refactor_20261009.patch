+"""pruning.conditions：独立职责模块；原实验入口保留兼容导入。"""
+from __future__ import annotations
+
+import json
+import random
+import re
+from collections import Counter
+from ..artifacts import (
+    checked_file,
+)
+from .contracts import (
+    GROUP_UNION,
+    INPUT_IMAGE_MODES,
+    ROW_SCOPES,
+    SUPPORT_BOX_MODES,
+)
+from ..source_contracts import (
+    heads_checked,
+)
+
+
+def load_keep_groups(spec):
+    """从冻结 head 集合里按 group 字段读出保留名单，并补一个 union。"""
+    frozen = spec["frozen_head_set"]
+    payload = json.loads(checked_file(frozen["path"], frozen["sha256"]))
+    entries = payload.get(frozen["key"]) if isinstance(payload, dict) else None
+    if not isinstance(entries, list) or not entries:
+        raise ValueError("frozen head set key missing or empty")
+    key = spec.get("group_key", "group")
+    groups = {}
+    for entry in entries:
+        if (
+            not isinstance(entry, dict)
+            or type(entry.get("layer")) is not int
+            or type(entry.get("head")) is not int
+        ):
+            raise ValueError("frozen head set entries require integer layer/head")
+        name = entry.get(key)
+        if not isinstance(name, str) or not name:
+            raise ValueError(f"frozen head set entries require a non-empty {key!r}")
+        groups.setdefault(name, []).append((entry["layer"], entry["head"]))
+    union = [pair for heads in groups.values() for pair in heads]
+    if len(set(union)) != len(union):
+        raise ValueError("keep groups overlap; the union keep set would be ambiguous")
+    groups[GROUP_UNION] = sorted(set(union))
+    for name, heads in groups.items():
+        groups[name] = heads_checked(heads, spec["num_layers"], spec["num_heads"])
+    return groups
+
+
+def sample_per_layer(rng, num_layers, width, per_layer, forbidden):
+    """逐层等数量抽样；``forbidden`` 内的 head 永不被选中。"""
+    if type(per_layer) is not int or per_layer < 1:
+        raise ValueError("per-layer removal count must be a positive integer")
+    selected = []
+    for layer in range(num_layers):
+        pool = [h for h in range(width) if (layer, h) not in forbidden]
+        if len(pool) < per_layer:
+            raise ValueError(
+                "insufficient same-layer heads for the requested removal count"
+            )
+        selected.extend((layer, h) for h in sorted(rng.sample(pool, per_layer)))
+    return selected
+
+
+def sample_per_layer_matching(rng, num_layers, width, profile):
+    """按给定 layer→count 画像抽样，用于「同层同数量的随机保留集合」。"""
+    selected = []
+    for layer in range(num_layers):
+        count = int(profile.get(layer, 0))
+        if count == 0:
+            continue
+        pool = list(range(width))
+        if len(pool) < count:
+            raise ValueError(
+                "insufficient same-layer heads for the matched keep profile"
+            )
+        selected.extend((layer, h) for h in sorted(rng.sample(pool, count)))
+    return selected
+
+
+def extreme_conditions(groups, num_layers, width, seeds):
+    """只跑极端档：baseline + 只留每组 + 同层同数量随机保留集合。"""
+    universe = {(layer, head) for layer in range(num_layers) for head in range(width)}
+    result = [dict(name="baseline", heads=[], mode="baseline")]
+    ordered = {name: heads for name, heads in groups.items() if name != GROUP_UNION}
+    ordered[GROUP_UNION] = groups[GROUP_UNION]
+    for name, heads in ordered.items():
+        keep = set(map(tuple, heads))
+        result.append(
+            dict(
+                name=f"keep_only:{name}",
+                heads=sorted(universe - keep),
+                mode="keep_only",
+                group=name,
+                keep_heads=sorted(keep),
+            )
+        )
+    for name, heads in ordered.items():
+        profile = Counter(layer for layer, _ in heads)
+        for seed in seeds:
+            rng = random.Random(seed * 100 + 9)
+            keep = sample_per_layer_matching(rng, num_layers, width, profile)
+            result.append(
+                dict(
+                    name=f"keep_only_random:{name}:seed{seed}",
+                    heads=sorted(universe - set(keep)),
+                    mode="keep_only_random",
+                    group=name,
+                    keep_heads=sorted(keep),
+                    seed=seed,
+                )
+            )
+    names = set()
+    for condition in result:
+        if condition["name"] in names:
+            raise ValueError(f"duplicate condition name: {condition['name']}")
+        names.add(condition["name"])
+        if condition["mode"] != "baseline":
+            heads_checked(condition["heads"], num_layers, width)
+    return result
+
+
+def input_image_conditions(modes):
+    """输入侧图像替换：不改注意力，只换参考帧 / 查询帧的图像本身。"""
+    if not isinstance(modes, (list, tuple)) or not modes:
+        raise ValueError("input_image_modes must be a non-empty list")
+    result = [dict(name="baseline", heads=[], mode="baseline")]
+    seen = set()
+    for mode in modes:
+        if mode not in INPUT_IMAGE_MODES:
+            raise ValueError(f"unknown input image mode: {mode}")
+        if mode in seen:
+            raise ValueError(f"duplicate input image mode: {mode}")
+        seen.add(mode)
+        result.append(
+            dict(
+                name=f"input_image:{mode}",
+                heads=[],
+                mode="input_image",
+                image_mode=mode,
+            )
+        )
+    return result
+
+
+def support_box_conditions(modes):
+    """不分组、不动注意力：逐模式改写 support 框坐标。"""
+    if not isinstance(modes, (list, tuple)) or not modes:
+        raise ValueError("support_box_modes must be a non-empty list")
+    result = [dict(name="baseline", heads=[], mode="baseline")]
+    seen = set()
+    for mode in modes:
+        if mode not in SUPPORT_BOX_MODES:
+            raise ValueError(f"unknown support box mode: {mode}")
+        if mode in seen:
+            raise ValueError(f"duplicate support box mode: {mode}")
+        seen.add(mode)
+        result.append(
+            dict(
+                name=f"support_box:{mode}",
+                heads=[],
+                mode="support_box",
+                support_box=mode,
+            )
+        )
+    return result
+
+
+def row_scope_conditions(scopes, num_layers, num_heads):
+    """不分组：每个来源组一条条件，移除全部 head 到目标图像的注意力边。"""
+    if not isinstance(scopes, (list, tuple)) or not scopes:
+        raise ValueError("row_scopes must be a non-empty list")
+    universe = [
+        (layer, head) for layer in range(num_layers) for head in range(num_heads)
+    ]
+    result = [dict(name="baseline", heads=[], mode="baseline")]
+    seen = set()
+    for scope in scopes:
+        if scope not in ROW_SCOPES:
+            raise ValueError(f"unknown row scope: {scope}")
+        name = f"row_scope:{scope}"
+        if name in seen:
+            raise ValueError(f"duplicate row scope: {scope}")
+        seen.add(name)
+        result.append(
+            dict(name=name, heads=list(universe), mode="row_scope", scope=scope)
+        )
+    return result
+
+
+def keepset_conditions(groups, num_layers, width, per_layer_counts, seeds):
+    """baseline + keep_only + 同规模随机保留 + protected/random 删除规模曲线。"""
+    if not isinstance(groups, dict) or not groups:
+        raise ValueError("at least one keep group is required")
+    ordered = {name: heads for name, heads in groups.items() if name != GROUP_UNION}
+    if GROUP_UNION not in groups:
+        raise ValueError("union keep group is required")
+    ordered[GROUP_UNION] = groups[GROUP_UNION]
+    universe = {(layer, head) for layer in range(num_layers) for head in range(width)}
+    result = [dict(name="baseline", heads=[], mode="baseline")]
+    names = set()
+    for name, heads in ordered.items():
+        keep = set(map(tuple, heads))
+        if not keep <= universe:
+            raise ValueError("keep group contains heads outside the model")
+        result.append(
+            dict(
+                name=f"keep_only:{name}",
+                heads=sorted(universe - keep),
+                mode="keep_only",
+                group=name,
+                keep_heads=sorted(keep),
+            )
+        )
+    for name, heads in ordered.items():
+        profile = Counter(layer for layer, _ in heads)
+        for seed in seeds:
+            rng = random.Random(seed * 100 + 9)
+            keep = sample_per_layer_matching(rng, num_layers, width, profile)
+            result.append(
+                dict(
+                    name=f"keep_only_random:{name}:seed{seed}",
+                    heads=sorted(universe - set(keep)),
+                    mode="keep_only_random",
+                    group=name,
+                    keep_heads=sorted(keep),
+                    seed=seed,
+                )
+            )
+    for name, heads in ordered.items():
+        keep = set(map(tuple, heads))
+        for per_layer in per_layer_counts:
+            for seed in seeds:
+                rng = random.Random(seed * 100 + per_layer)
+                removed = sample_per_layer(rng, num_layers, width, per_layer, keep)
+                result.append(
+                    dict(
+                        name=f"protected:{name}:perlayer{per_layer}:seed{seed}",
+                        heads=removed,
+                        mode="protected",
+                        group=name,
+                        per_layer=per_layer,
+                        seed=seed,
+                    )
+                )
+    for per_layer in per_layer_counts:
+        for seed in seeds:
+            rng = random.Random(seed * 100 + per_layer + 7)
+            removed = sample_per_layer(rng, num_layers, width, per_layer, set())
+            result.append(
+                dict(
+                    name=f"random:perlayer{per_layer}:seed{seed}",
+                    heads=removed,
+                    mode="random",
+                    per_layer=per_layer,
+                    seed=seed,
+                )
+            )
+    for condition in result:
+        if not isinstance(condition["name"], str) or not condition["name"]:
+            raise ValueError("condition names must be non-empty")
+        if condition["name"] in names:
+            raise ValueError(f"duplicate condition name: {condition['name']}")
+        names.add(condition["name"])
+        if condition["mode"] != "baseline":
+            heads_checked(condition["heads"], num_layers, width)
+    return result
+
+
+def head_label_pairs(labels):
+    pairs = []
+    for label in labels:
+        match = re.fullmatch(r"L(\d+)H(\d+)", str(label))
+        if match is None:
+            raise ValueError(f"bad head label: {label!r}")
+        pairs.append((int(match.group(1)), int(match.group(2))))
+    return pairs
+
+
+def condition_integrity(plan):
+    """条件级完整性：规模、每层数量、与保留组的重合。"""
+    groups = {
+        name: set(head_label_pairs(labels))
+        for name, labels in plan["keep_groups"].items()
+    }
+    rows = []
+    for condition in plan["conditions"]:
+        heads = set(map(tuple, condition["heads"]))
+        per_layer = Counter(layer for layer, _ in heads)
+        row = dict(
+            name=condition["name"],
+            mode=condition["mode"],
+            removed_heads=len(heads),
+            per_layer=dict(sorted(per_layer.items())),
+            overlap_with_keep={
+                name: len(heads & members) for name, members in groups.items()
+            },
+        )
+        if condition["mode"] in {"protected", "random"}:
+            expected = condition["per_layer"]
+            if sorted(set(per_layer.values())) != [expected]:
+                raise ValueError(f"{condition['name']} is not equal-count per layer")
+        if condition["mode"] == "protected":
+            if heads & groups[condition["group"]]:
+                raise ValueError(
+                    "protected condition removed heads from its own keep group"
+                )
+        rows.append(row)
+    return rows
