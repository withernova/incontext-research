+"""Compatibility and import boundaries for head-screening responsibility modules."""
+import subprocess
+import sys
+
+import pytest
+
+
+@pytest.mark.parametrize(
+    "module,options",
+    [
+        (
+            "iploc_szy.head_screening.keepset_pruning",
+            ("--validate-only", "--recompute"),
+        ),
+        ("iploc_szy.head_screening.top10_head_ablation", ("--validate-only",)),
+    ],
+)
+def test_legacy_cli_help_remains_available_without_loading_models(module, options):
+    result = subprocess.run(
+        [sys.executable, "-m", module, "--help"],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    for option in options:
+        assert option in result.stdout
+
+
+def test_old_analysis_entrypoint_resolves_to_the_extracted_worker():
+    from tools.analyze import resolve_entrypoint
+    from iploc_szy.head_screening.target_background.worker import (
+        run_r008_target_vs_background_ablation,
+    )
+
+    resolved = resolve_entrypoint(
+        "iploc_szy.head_screening.target_vs_background_ablation:"
+        "run_r008_target_vs_background_ablation"
+    )
+    assert resolved is run_r008_target_vs_background_ablation
+
+
+def test_pure_head_utilities_do_not_import_qwen_implementation_or_initialize_cuda():
+    program = """
+import sys
+import torch
+from iploc_szy.head_screening.pruning.metrics import cluster_bootstrap_ci
+from iploc_szy.head_screening.target_background.masks import attention_mass_matched_mask
+from iploc_szy.head_screening.source_contracts import heads_checked
+assert not torch.cuda.is_initialized()
+assert 'transformers.models.qwen3_vl.modeling_qwen3_vl' not in sys.modules
+assert heads_checked([[0, 1]], 2, 4) == [(0, 1)]
+assert cluster_bootstrap_ci({'a': [1.], 'b': [1.]}, 7, 100) == [1., 1.]
+"""
+    subprocess.run(
+        [sys.executable, "-c", program], capture_output=True, text=True, check=True
+    )
