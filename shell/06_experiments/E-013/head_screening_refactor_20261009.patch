+"""target_background.metrics：独立职责模块；原实验入口保留兼容导入。"""
+from __future__ import annotations
+
+from collections import Counter
+import numpy as np
+from ..localization import (
+    BOX,
+    iou,
+    valid_box,
+)
+from .contracts import (
+    MATCHED_BACKGROUND_CONDITIONS,
+)
