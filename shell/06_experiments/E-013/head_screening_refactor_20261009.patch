-def write_json(path, value, retries=60, delay=15.0):
-    """写 JSON；共享文件系统瞬时打满（ENOSPC）时退避重试，其余错误直接抛出。"""
-    path = Path(path)
-    payload = json.dumps(value, ensure_ascii=False, indent=2, allow_nan=False) + "\n"
-    tmp = path.with_suffix(path.suffix + ".tmp")
-    for attempt in range(max(1, int(retries))):
-        try:
-            tmp.write_text(payload)
-            tmp.replace(path)
-            return
-        except OSError as error:
-            if error.errno != errno.ENOSPC or attempt + 1 >= max(1, int(retries)):
-                raise
-            time.sleep(delay)
