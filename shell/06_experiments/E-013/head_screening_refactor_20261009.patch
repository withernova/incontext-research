+"""pruning.inputs：独立职责模块；原实验入口保留兼容导入。"""
+from __future__ import annotations
+
+import copy
+import re
+from .contracts import (
+    BOX_TEXT,
+    INPUT_IMAGE_MODES,
+    SUPPORT_BOX_MODES,
+)
+
+
+def format_normalized_box(box):
+    return "[" + ",".join(str(int(round(float(value)))) for value in box) + "]"
+
+
+def parse_normalized_box(text):
+    values = re.findall(r"[-+]?\d*\.?\d+", str(text))
+    if len(values) != 4:
+        raise ValueError(f"expected four coordinates, got {values!r}")
+    return [float(value) for value in values]
+
+
+def shift_box(box, delta, scale=1000):
+    """整体平移（只动 x），保持合法框：x1<x2 且落在 [0, scale]。"""
+    x1, y1, x2, y2 = box
+    x1s = min(max(0.0, x1 + delta), scale - 1.0)
+    x2s = min(max(x1s + 1.0, x2 + delta), float(scale))
+    return [x1s, y1, x2s, y2]
+
+
+def perturb_support_box(
+    original_text, mode, rng, query_box=None, donor_text=None, scale=1000
+):
+    """按模式改写 support 框文本；只改坐标值，不改格式约定。"""
+    if mode not in SUPPORT_BOX_MODES:
+        raise ValueError(f"unknown support box mode: {mode}")
+    box = parse_normalized_box(original_text)
+    if mode == "respace":
+        return "[" + ", ".join(str(int(round(value))) for value in box) + "]"
+    if mode == "zero":
+        return "[0,0,0,0]"
+    if mode == "center":
+        return format_normalized_box([250, 250, 750, 750])
+    if mode == "random":
+        width, height = rng.uniform(50, 300), rng.uniform(50, 300)
+        x1, y1 = rng.uniform(0, scale - width), rng.uniform(0, scale - height)
+        return format_normalized_box([x1, y1, x1 + width, y1 + height])
+    if mode == "shift5":
+        return format_normalized_box(shift_box(box, 0.05 * scale, scale))
+    if mode == "shift25":
+        return format_normalized_box(shift_box(box, 0.25 * scale, scale))
+    if mode == "shuffle_box":
+        if donor_text is None:
+            raise ValueError("shuffle_box requires a donor support box")
+        return donor_text
+    if mode == "oracle_query_gt":
+        if query_box is None:
+            raise ValueError("oracle_query_gt requires the query target box")
+        return format_normalized_box(query_box)
+    raise ValueError(f"unhandled support box mode: {mode}")
+
+
+def perturb_support_messages(messages, new_box):
+    """只改第一处带 BBOX 的 user 文本里的坐标字段，其余（含助手答案）原样保留。"""
+    result = copy.deepcopy(messages)
+    changed = False
+    for message in result:
+        content = message.get("content")
+        parts = (
+            content
+            if isinstance(content, list)
+            else [{"type": "text", "text": content}]
+        )
+        for part in parts:
+            if not isinstance(part, dict) or part.get("type") != "text" or changed:
+                continue
+            text = part.get("text") or ""
+            if "BBOX" not in text or not BOX_TEXT.search(text):
+                continue
+            part["text"] = BOX_TEXT.sub(new_box, text, count=1)
+            changed = True
+    if not changed:
+        raise ValueError("no support BBOX field found in the user turns")
+    return result
+
+
+def image_part_indexes(messages):
+    """按出现顺序返回所有图像 part 的 (message_index, part_index)。"""
+    result = []
+    for m_index, message in enumerate(messages):
+        content = message.get("content")
+        if not isinstance(content, list):
+            continue
+        for p_index, part in enumerate(content):
+            if isinstance(part, dict) and part.get("type") == "image":
+                result.append((m_index, p_index))
+    if len(result) != 2:
+        raise ValueError(
+            f"expected exactly two images in the prompt, got {len(result)}"
+        )
+    return result
+
+
+def replace_image_parts(messages, mode, black_path, donor_reference_path=None):
+    """按模式替换参考帧 / 查询帧图像；文本（含 support 框）保持完全不变。"""
+    if mode not in INPUT_IMAGE_MODES:
+        raise ValueError(f"unknown input image mode: {mode}")
+    result = copy.deepcopy(messages)
+    indexes = image_part_indexes(result)
+    reference_index, query_index = indexes[0], indexes[-1]
+    if mode in {"black_reference", "black_all"}:
+        result[reference_index[0]]["content"][reference_index[1]]["image"] = str(
+            black_path
+        )
+    if mode in {"black_query", "black_all"}:
+        result[query_index[0]]["content"][query_index[1]]["image"] = str(black_path)
+    if mode == "swap_reference":
+        if donor_reference_path is None:
+            raise ValueError("swap_reference requires a donor reference frame")
+        result[reference_index[0]]["content"][reference_index[1]]["image"] = str(
+            donor_reference_path
+        )
+    if mode == "swap_query":
+        if donor_reference_path is None:
+            raise ValueError("swap_query requires a donor frame")
+        result[query_index[0]]["content"][query_index[1]]["image"] = str(
+            donor_reference_path
+        )
+    return result
+
+
+def apply_input_image_mode(sample, mode, black_path, donor_reference_path=None):
+    """换图必须同时改 messages 与 image_paths：collator 只从 image_paths 读图。"""
+    modified = dict(sample)
+    messages = replace_image_parts(
+        sample["messages"], mode, black_path, donor_reference_path
+    )
+    modified["messages"] = messages
+    indexes = image_part_indexes(messages)
+    modified["image_paths"] = [messages[i]["content"][j]["image"] for i, j in indexes]
+    if len(modified["image_paths"]) != 2:
+        raise ValueError("image replacement must keep exactly two image paths")
+    return modified
