+    if conditions_mode not in {"full", "joint_only"}:
+        raise ValueError("conditions_mode must be 'full' or 'joint_only'")
+    if conditions_mode == "joint_only" and spec.get("combine_r001_top10_with_legacy"):
+        raise ValueError(
+            "joint_only cannot be combined with combine_r001_top10_with_legacy"
+        )
+    if legacy is not None and frozen_set is not None:
+        raise ValueError(
+            "legacy_head_source and frozen_head_set are mutually exclusive"
+        )
