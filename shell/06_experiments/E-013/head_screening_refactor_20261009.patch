+        implementation.eager_attention_forward = intercepted
+        handle = None
+        if tracker is not None:
+            text_cfg = getattr(model.config, "text_config", model.config)
+            vocab_size = int(getattr(text_cfg, "vocab_size", 0) or 0)
+            if vocab_size <= 0:
+                raise ValueError("cannot read the text vocab size for prefix tracking")
+            embedding = text_embedding_module(model, vocab_size)
+            handle = embedding.register_forward_pre_hook(capture, with_kwargs=True)
+        try:
+            yield self
+        finally:
+            implementation.eager_attention_forward = original
+            if handle is not None:
+                handle.remove()
+
+    def validate(self, expected_calls, num_layers):
+        if set(self.layer_calls) != set(range(num_layers)) or any(
+            n != expected_calls for n in self.layer_calls.values()
+        ):
+            raise ValueError("attention interception did not cover every forward/layer")
+
+
+def image_span(spans, role):
+    """按角色取图像视觉 token 跨度：reference=第一个图像，query=最后一个图像。"""
+    if role not in {"query", "reference"}:
+        raise ValueError("image_role must be 'query' or 'reference'")
+    if not isinstance(spans, (list, tuple)) or len(spans) != 2:
+        raise ValueError("R-011/R-012 协议要求恰好一个 reference 与一个 query 图像")
+    span = spans[0] if role == "reference" else spans[-1]
+    return int(span[0]), int(span[1])
