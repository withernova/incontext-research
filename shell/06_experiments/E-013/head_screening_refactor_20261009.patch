+            }
+            <= set(override)
+        ):
+            raise ValueError(
+                "checkpoint_override requires path and adapter_weights_sha256 only"
+            )
+        override_root = Path(override["path"]).resolve()
+        for sub in ("adapter", "adapter_processor"):
+            if not (override_root / sub).is_dir():
