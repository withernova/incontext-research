+"""target_background.hooks：独立职责模块；原实验入口保留兼容导入。"""
+from __future__ import annotations
+
+from collections import Counter
+from contextlib import contextmanager
+import torch
+from ..probes import temporary_eager_attention
+from .masks import (
+    _finite_mask,
+)
+
+
+class ReferenceAttentionMassHook:
+    """Read-only baseline capture of per-head Reference key attention mass."""
+
+    def __init__(self, heads, reference_span, prediction_rows):
+        self.heads = {tuple(map(int, head)) for head in heads}
+        self.span = (int(reference_span[0]), int(reference_span[1]))
+        self.rows = [int(value) for value in prediction_rows]
+        self.mass = {}
+        self.layer_calls = Counter()
+
+    @contextmanager
+    def installed(self, model):
+        from transformers.models.qwen3_vl import modeling_qwen3_vl as implementation
+
+        original = implementation.eager_attention_forward
+        modules = [
+            module
+            for module in model.modules()
+            if module.__class__.__name__ == "Qwen3VLTextAttention"
+        ]
+        if not modules or model.training:
+            raise ValueError("attention capture requires eval Qwen3-VL text attention")
+        layers = {int(module.layer_idx) for module in modules}
+        if not {layer for layer, _ in self.heads} <= layers:
+            raise ValueError("captured head layer exceeds the loaded text model")
+        start, stop = self.span
+        if self.rows and min(self.rows) < 0:
+            raise ValueError("prediction rows must be non-negative")
+
+        def intercepted(
+            module, query, key, value, attention_mask, scaling, dropout=0.0, **kwargs
+        ):
+            output, attention = original(
+                module, query, key, value, attention_mask, scaling, dropout, **kwargs
+            )
+            if module.__class__.__name__ != "Qwen3VLTextAttention":
+                return output, attention
+            layer = int(module.layer_idx)
+            self.layer_calls[layer] += 1
+            heads = sorted(head for l, head in self.heads if l == layer)
+            if not heads:
+                return output, attention
+            if attention.shape[-1] < stop:
+                raise ValueError("Reference span exceeds the attention key length")
+            for head in heads:
+                self.mass[(layer, head)] = (
+                    attention[0, head, self.rows, start:stop]
+                    .detach()
+                    .float()
+                    .sum(0)
+                    .cpu()
+                    .numpy()
+                )
+            return output, attention
+
+        implementation.eager_attention_forward = intercepted
+        try:
+            with temporary_eager_attention(model):
+                yield self
+        finally:
+            implementation.eager_attention_forward = original
+
+
+def apply_edge_removal(attention, values, masks, rows, span):
+    """Scale post-softmax edges and recompute A@V without renormalization.
+
+    ``attention`` is ``[batch, heads, queries, keys]`` and ``values`` is
+    ``[batch, heads, keys, head_dim]``.  ``masks`` maps a head index to a
+    fractional removal weight in ``[0, 1]`` for every key of ``span``.  Returns
+    the recomputed head output in ``[batch, queries, heads, head_dim]`` layout,
+    the scaled attention, and per-head removed mass / intervened entries.
+    """
+    if attention.ndim != 4 or values.ndim != 4:
+        raise ValueError("attention and values must be 4-D tensors")
+    if (
+        attention.shape[0] != values.shape[0]
+        or attention.shape[1] != values.shape[1]
+        or attention.shape[-1] != values.shape[-2]
+    ):
+        raise ValueError("attention and value shapes are incompatible")
+    start, stop = int(span[0]), int(span[1])
+    if not 0 <= start < stop <= attention.shape[-1]:
+        raise ValueError("reference span lies outside the attention keys")
+    selected = (
+        list(range(attention.shape[-2])) if rows is None else [int(row) for row in rows]
+    )
+    if not selected or min(selected) < 0 or max(selected) >= attention.shape[-2]:
+        raise ValueError("prediction rows lie outside the attention queries")
+    if not masks:
+        raise ValueError("edge removal needs at least one head mask")
+    scaled = attention.clone()
+    removed, entries = {}, {}
+    for head, raw_mask in masks.items():
+        head = int(head)
+        if not 0 <= head < attention.shape[1]:
+            raise ValueError("masked head lies outside the attention tensor")
+        mask = _finite_mask(raw_mask, f"mask for head {head}").reshape(-1)
+        if mask.size != stop - start:
+            raise ValueError("mask length differs from the reference span")
+        weights = torch.as_tensor(mask, device=attention.device, dtype=torch.float32)
+        before = attention[0, head, selected, start:stop].float()
+        scaled[0, head, selected, start:stop] = (before * (1.0 - weights)).to(
+            attention.dtype
+        )
+        removed[head] = float((before * weights).sum())
+        entries[head] = len(selected) * (stop - start)
+    output = torch.matmul(scaled, values).transpose(1, 2).contiguous()
+    return output, scaled, removed, entries
+
+
+class VisualEdgeRemovalHook:
+    """Scale post-softmax Reference edges before A@V for selected text heads."""
+
+    def __init__(self, plan, reference_span, prediction_rows=None, label=""):
+        self.plan = {
+            tuple(map(int, key)): _finite_mask(value, f"mask {key}").reshape(-1)
+            for key, value in plan.items()
+        }
+        self.span = (int(reference_span[0]), int(reference_span[1]))
+        if self.span[1] <= self.span[0]:
+            raise ValueError("Reference span must be non-empty")
+        self.rows = (
+            None if prediction_rows is None else [int(v) for v in prediction_rows]
+        )
+        self.label = str(label)
+        self.layer_calls = Counter()
+        self.audits = {}
+        for (layer, head), mask in self.plan.items():
+            if mask.size != self.span[1] - self.span[0]:
+                raise ValueError("mask length differs from the Reference span")
+            self.audits[self._label(layer, head)] = {
+                "layer": layer,
+                "head": head,
+                "calls": 0,
+                "prefill_calls": 0,
+                "decode_calls": 0,
+                "intervened_entries": 0,
+                "removed_occupancy": float(mask.sum()),
+                "removed_attention_mass_sum": 0.0,
+                "max_abs_av_delta": 0.0,
+            }
+
+    @staticmethod
+    def _label(layer, head):
+        return f"L{int(layer):02d}H{int(head):02d}"
+
+    @contextmanager
+    def installed(self, model):
+        from transformers.models.qwen3_vl import modeling_qwen3_vl as implementation
+
+        original = implementation.eager_attention_forward
+        modules = [
+            module
+            for module in model.modules()
+            if module.__class__.__name__ == "Qwen3VLTextAttention"
+        ]
+        if not modules or model.training:
+            raise ValueError("edge removal requires eval Qwen3-VL text attention")
+        layers = {int(module.layer_idx) for module in modules}
+        if not {layer for layer, _ in self.plan} <= layers:
+            raise ValueError("intervened head layer exceeds the loaded text model")
+        start, stop = self.span
+
+        def intercepted(
+            module, query, key, value, attention_mask, scaling, dropout=0.0, **kwargs
+        ):
+            output, attention = original(
+                module, query, key, value, attention_mask, scaling, dropout, **kwargs
+            )
+            if module.__class__.__name__ != "Qwen3VLTextAttention":
+                return output, attention
+            layer = int(module.layer_idx)
+            self.layer_calls[layer] += 1
+            heads = sorted(head for l, head in self.plan if l == layer)
+            if not heads:
+                return output, attention
+            if query.shape[0] != 1 or dropout != 0:
+                raise ValueError("edge removal requires batch=1 and dropout=0")
+            if attention.shape[-1] < stop:
+                raise ValueError("Reference span exceeds the attention key length")
+            rows = list(range(attention.shape[-2])) if self.rows is None else self.rows
+            if rows and max(rows) >= attention.shape[-2]:
+                raise ValueError("prediction rows exceed the attention query length")
+            values = implementation.repeat_kv(value, module.num_key_value_groups)
+            masks = {head: self.plan[(layer, head)] for head in heads}
+            head_output, scaled, removed, entries = apply_edge_removal(
+                attention, values, masks, self.rows, self.span
+            )
+            output = output.clone()
+            for head in heads:
+                audit = self.audits[self._label(layer, head)]
+                audit["calls"] += 1
+                audit[
+                    "prefill_calls" if attention.shape[-2] > 1 else "decode_calls"
+                ] += 1
+                audit["intervened_entries"] += entries[head]
+                audit["removed_attention_mass_sum"] += removed[head]
+                audit["max_abs_av_delta"] = max(
+                    audit["max_abs_av_delta"],
+                    float(
+                        (head_output[:, :, head, :] - output[:, :, head, :]).abs().max()
+                    ),
+                )
+                output[:, :, head, :] = head_output[:, :, head, :]
+            return output, scaled
+
+        implementation.eager_attention_forward = intercepted
+        try:
+            with temporary_eager_attention(model):
+                yield self
+        finally:
+            implementation.eager_attention_forward = original
+
+    def validate(self, expected_calls):
+        calls = sorted(set(self.layer_calls.values()))
+        if calls != [int(expected_calls)]:
+            raise ValueError(
+                f"attention interception covered {calls} calls, expected "
+                f"{expected_calls} for every text layer"
+            )
+        for label, audit in self.audits.items():
+            if audit["calls"] != int(expected_calls):
+                raise ValueError(f"{label} missed forward calls ({audit['calls']})")
+            if audit["intervened_entries"] <= 0:
+                raise ValueError(f"{label} intervened on no attention entry")
+        return int(expected_calls)
