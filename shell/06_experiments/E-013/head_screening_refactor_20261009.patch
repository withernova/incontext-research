+def recompute(root):
+    """从已有 records.json 离线重算 summary/integrity（合同要求 summary 只能这样得到）。"""
+    root = Path(root)
+    plan = json.loads((root / "resolved_plan.json").read_text())
+    payload = json.loads((root / "records.json").read_text())
+    records = payload["records"]
+    expected = len(plan["conditions"]) * plan["sample_count"]
+    if len(records) != expected:
+        raise ValueError(f"records incomplete: {len(records)} != {expected}")
+    summary = summarize(records, plan)
+    write_json(
+        root / "summary.json",
+        dict(
+            schema=SCHEMA,
+            status="completed_recomputed",
+            records=len(records),
+            invalid_output_iou_policy="zero_in_full_denominator",
+            delta_direction="intervention_minus_baseline",
+            tolerance_delta_iou=plan["spec"]["tolerance_delta_iou"],
+            recomputed_from="records.json",
+            summary=summary,
+            verdicts=paired_verdicts(summary, plan),
+        ),
+    )
+    write_json(root / "integrity.json", summary_integrity(records, plan))
+    write_json(root / "records.json", dict(payload, status="completed"))
+    return dict(
