+"""target_background.masks：独立职责模块；原实验入口保留兼容导入。"""
+from __future__ import annotations
+
+import numpy as np
+from ..reference_target_screening import make_frozen_null_occupancies
+from .contracts import (
+    CONDITIONS,
+)
+
+
+def _finite_mask(values, name):
+    array = np.asarray(values, dtype=np.float64)
+    if (
+        array.size == 0
+        or not np.isfinite(array).all()
+        or np.any((array < 0) | (array > 1))
+    ):
+        raise ValueError(f"{name} must be a finite non-empty array in [0, 1]")
+    return array
+
+
+def reference_occupancy(region_weights, reference_span, visual_span):
+    weights = np.asarray(region_weights["reference_target"], dtype=np.float64)
+    visual_start, visual_stop = int(visual_span[0]), int(visual_span[1])
+    if weights.ndim != 1 or weights.shape[0] != visual_stop - visual_start:
+        raise ValueError("Reference region weights must cover the full visual span")
+    start, stop = int(reference_span[0]), int(reference_span[1])
+    if not visual_start <= start < stop <= visual_stop:
+        raise ValueError("Reference span lies outside the captured visual span")
+    return np.ascontiguousarray(weights[start - visual_start : stop - visual_start])
+
+
+def attention_mass_matched_mask(attention, target_mask, *, tolerance):
+    """Greedy fractional background mask matching the target's removed attention mass."""
+    a = np.asarray(attention, dtype=np.float64).reshape(-1)
+    t = _finite_mask(target_mask, "target_mask").reshape(-1)
+    if a.shape != t.shape or a.size == 0:
+        raise ValueError(
+            "attention mass and target mask must share one non-empty shape"
+        )
+    if not np.isfinite(a).all() or np.any(a < 0):
+        raise ValueError("attention mass must be finite and non-negative")
+    target_mass = float((a * t).sum())
+    if target_mass <= 0:
+        raise ValueError("target removed attention mass must be positive")
+    capacity = np.where(t > 0, 0.0, a)
+    available = float(capacity.sum())
+    if available + 1e-12 < target_mass:
+        return None, {
+            "feasible": False,
+            "target_mass": target_mass,
+            "available_mass": available,
+            "removed_mass": None,
+            "relative_error": None,
+        }
+    mask = np.zeros_like(a)
+    remaining = target_mass
+    for index in np.argsort(-capacity, kind="stable"):
+        if remaining <= 1e-12:
+            break
+        if capacity[index] <= 0:
+            continue
+        take = min(float(capacity[index]), remaining)
+        mask[index] = min(1.0, take / float(a[index]))
+        remaining -= take
+    removed = float((a * mask).sum())
+    error = abs(removed - target_mass) / target_mass
+    if error > float(tolerance):
+        return None, {
+            "feasible": False,
+            "target_mass": target_mass,
+            "available_mass": available,
+            "removed_mass": removed,
+            "relative_error": error,
+        }
+    return mask, {
+        "feasible": True,
+        "target_mass": target_mass,
+        "available_mass": available,
+        "removed_mass": removed,
+        "relative_error": error,
+    }
+
+
+def build_group_masks(
+    occupancy, grid_shape, attention_mass, groups, required, null_seed=None
+):
+    """Resolve every frozen condition mask for one sample.
+
+    ``radial_matched`` (the R-005 frozen area-matched background) stands for the
+    same-token-count/area-matched background and ``same_size_shifted`` for the
+    shifted-GT null.  The attention-mass-matched background is built per head.
+    """
+    g = _finite_mask(occupancy, "reference_target_occupancy").reshape(-1)
+    grid = tuple(int(value) for value in grid_shape)
+    if len(grid) != 2 or int(np.prod(grid)) != g.size:
+        raise ValueError("merged Reference grid does not match the occupancy length")
+    if g.sum() <= 0 or np.all(g > 0):
+        raise ValueError("Reference occupancy needs both target and background cells")
+    names = tuple(str(value) for value in required["null_names"])
+    seed = int(required["null_seed"]) if null_seed is None else int(null_seed)
+    nulls = make_frozen_null_occupancies(g.reshape(grid), names, seed)
+    background_area = _finite_mask(nulls["radial_matched"], "radial_matched").reshape(
+        -1
+    )
+    shifted_null = _finite_mask(
+        nulls["same_size_shifted"], "same_size_shifted"
+    ).reshape(-1)
+
+    prepared = {}
+    for group in groups:
+        heads = [tuple(map(int, head)) for head in group["heads"]]
+        entry = {}
+        for condition in CONDITIONS:
+            if condition == "target":
+                masks = np.stack([g] * len(heads))
+                audit = {
+                    "feasible": True,
+                    "target_mass": None,
+                    "available_mass": None,
+                    "removed_mass": None,
+                    "relative_error": None,
+                }
+            elif condition == "background_token":
+                masks = np.stack([background_area] * len(heads))
+                audit = {
+                    "feasible": True,
+                    "target_mass": None,
+                    "available_mass": None,
+                    "removed_mass": None,
+                    "relative_error": None,
+                }
+            elif condition == "null_shifted":
+                masks = np.stack([shifted_null] * len(heads))
+                audit = {
+                    "feasible": True,
+                    "target_mass": None,
+                    "available_mass": None,
+                    "removed_mass": None,
+                    "relative_error": None,
+                }
+            else:
+                rows, audits, feasible = [], [], True
+                for head in heads:
+                    if head not in attention_mass:
+                        raise ValueError(
+                            f"baseline attention mass missing for L{head[0]}H{head[1]}"
+                        )
+                    mask, detail = attention_mass_matched_mask(
+                        attention_mass[head],
+                        g,
+                        tolerance=required["background_attention_tolerance"],
+                    )
+                    audits.append(detail)
+                    if mask is None:
+                        feasible = False
+                        rows = None
+                        break
+                    rows.append(mask)
+                masks = np.stack(rows) if feasible else None
+                audit = {"feasible": feasible, "per_head": audits}
+            if masks is not None:
+                masks = np.asarray(masks, dtype=np.float64)
+                if masks.shape != (len(heads), g.size):
+                    raise ValueError("resolved mask shape differs from group size")
+            entry[condition] = {
+                "plan": (
+                    {
+                        (layer, head): masks[index]
+                        for index, (layer, head) in enumerate(heads)
+                    }
+                    if masks is not None
+                    else None
+                ),
+                "masks": masks,
+                "audit": {
+                    "requested_removed_occupancy": float(masks.sum(axis=1).mean())
+                    if masks is not None
+                    else None,
+                    "requested_removed_tokens": float((masks > 0).sum(axis=1).mean())
+                    if masks is not None
+                    else None,
+                    "target_removed_attention_mass": (
+                        float(
+                            np.mean(
+                                [float((attention_mass[h] * g).sum()) for h in heads]
+                            )
+                        )
+                        if all(h in attention_mass for h in heads)
+                        else None
+                    ),
+                    "overlap_with_target": (
+                        float(np.minimum(masks, g[None, :]).sum(axis=1).mean())
+                        if masks is not None
+                        else None
+                    ),
+                    **audit,
+                },
+            }
+        prepared[group["name"]] = entry
+    return prepared
