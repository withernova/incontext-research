+
+def resolve_generation_sample_count(value, causal_sample_count):
+    """Resolve an explicit integer budget or ``"all"`` against the frozen split."""
+    if type(causal_sample_count) is not int or causal_sample_count < 1:
+        raise ValueError("causal_sample_count must be a positive integer")
+    if value == "all":
+        return causal_sample_count
+    if type(value) is not int or not 0 <= value <= causal_sample_count:
+        raise ValueError(
+            "generation_sample_count must be 'all' or an integer in "
+            f"[0, {causal_sample_count}]"
+        )
+    return value
+
+
+def _nanmean_or_none(values):
+    values = np.asarray(values, dtype=np.float64)
+    return float(np.nanmean(values)) if np.isfinite(values).any() else None
+
+
+def condition_matrices(records, groups, conditions):
+    """Return {(group, condition): 1-D per-sample delta CE} plus fit counts."""
+    matrices, counts = {}, {}
+    for group in groups:
+        name = group["name"]
+        for condition in conditions:
+            values = np.full(len(records), np.nan, dtype=np.float64)
+            total = valid = unmatched = 0
+            for index, record in enumerate(records):
+                entry = (record.get("conditions") or {}).get(f"{name}|{condition}")
+                if entry is None:
+                    raise ValueError(
+                        f"missing {name}|{condition} for {record.get('sample_id')}"
+                    )
+                total += 1
+                if entry.get("feasible") and entry.get("delta_ce") is not None:
+                    values[index] = float(entry["delta_ce"])
+                    valid += 1
+                else:
+                    unmatched += 1
+            matrices[(name, condition)] = values
+            counts[(name, condition)] = {
+                "n_total": total,
+                "n_valid": valid,
+                "n_unmatched": unmatched,
+            }
+    return matrices, counts
+
+
+def target_specific_damage_matrix(
+    matrices, group_names, conditions=MATCHED_BACKGROUND_CONDITIONS
+):
+    """Per-sample target damage minus the mean matched-background damage."""
+    output = {}
+    for name in group_names:
+        target = matrices[(name, "target")]
+        backgrounds = np.stack(
+            [matrices[(name, condition)] for condition in conditions], axis=1
+        )
+        output[name] = target - np.nanmean(backgrounds, axis=1)
+        output[name][~np.isfinite(target)] = np.nan
+        output[name][np.all(~np.isfinite(backgrounds), axis=1)] = np.nan
+    return output
+
+
+def cluster_bootstrap(values, clusters, replicates, seed):
+    """Component-cluster bootstrap over every named per-sample array jointly."""
+    clusters = np.asarray([str(value) for value in clusters])
+    unique = sorted(set(clusters.tolist()))
+    if not unique or int(replicates) < 1:
+        raise ValueError("bootstrap needs at least one cluster and one replicate")
+    index_by_cluster = {key: np.flatnonzero(clusters == key) for key in unique}
+    rng = np.random.default_rng(int(seed))
+    draws = {
+        name: np.full(int(replicates), np.nan, dtype=np.float64) for name in values
+    }
+    for replicate in range(int(replicates)):
+        chosen = rng.integers(0, len(unique), size=len(unique))
+        index = np.concatenate(
+            [index_by_cluster[unique[position]] for position in chosen]
+        )
+        for name, array in values.items():
+            sample = np.asarray(array, dtype=np.float64)[index]
+            sample = sample[np.isfinite(sample)]
+            if sample.size:
+                draws[name][replicate] = float(sample.mean())
+    output = {}
+    for name, array in values.items():
+        finite = np.isfinite(np.asarray(array, dtype=np.float64))
+        boot = draws[name][np.isfinite(draws[name])]
+        output[name] = {
+            "mean": _nanmean_or_none(array),
+            "ci95": [float(np.quantile(boot, 0.025)), float(np.quantile(boot, 0.975))]
+            if boot.size
+            else None,
+            "n_total": int(finite.size),
+            "n_valid": int(finite.sum()),
+            "n_clusters": len(unique),
+        }
+    return output
+
+
+def difference_in_difference(did_pairs, damage):
+    output = {}
+    for candidate, control in did_pairs:
+        if candidate not in damage or control not in damage:
+            raise ValueError(
+                f"DiD pair names are not resolved groups: {candidate} | {control}"
+            )
+        first, second = damage[candidate], damage[control]
+        values = first - second
+        values[~(np.isfinite(first) & np.isfinite(second))] = np.nan
+        output[f"{candidate}|{control}"] = values
+    return output
+
+
+def per_head_verdicts(
+    groups,
+    stats,
+    damage_stats,
+    did_stats,
+    did_pairs,
+    empty_hook_ok,
+    *,
+    alpha,
+    per_head_tests,
+):
+    """Classify every frozen per-head group; no winner-only reporting."""
+    output = {}
+    controls = {}
+    for candidate, control in did_pairs:
+        if candidate.startswith("head_"):
+            controls.setdefault(candidate, []).append(control)
+    adjusted = float(alpha) / max(1, int(per_head_tests))
+    for group in groups:
+        if group["kind"] != "head":
+            continue
+        name = group["name"]
+        delta = stats.get((name, "target"), {})
+        damage = damage_stats.get(name, {})
+        target_ci = delta.get("ci95")
+        damage_ci = damage.get("ci95")
+        supported = bool(
+            empty_hook_ok
+            and delta.get("n_valid", 0) > 0
+            and target_ci is not None
+            and target_ci[0] > 0
+            and damage_ci is not None
+            and damage_ci[0] > 0
+        )
+        differences = {}
+        for control in controls.get(name, []):
+            entry = did_stats.get(f"{name}|{control}", {})
+            differences[control] = entry
+            if entry.get("mean") is None or entry["mean"] <= 0:
+                supported = False
+        if (
+            not supported
+            and (delta.get("mean") or 0) > 0
+            and (damage.get("mean") or 0) > 0
+        ):
+            verdict = "spatially_related_only"
+        elif supported:
+            verdict = "causal_target_specific"
+        else:
+            verdict = "unsupported"
+        output[name] = {
+            "heads": group["heads"],
+            "verdict": verdict,
+            "delta_ce_target": delta,
+            "target_specific_damage": damage,
+            "difference_in_difference": differences,
+            "empty_hook_passed": bool(empty_hook_ok),
+            "bonferroni_alpha": adjusted,
+            "raw_alpha": float(alpha),
+            "per_head_tests": int(per_head_tests),
+            "criterion": (
+                "empty hook parity AND target CI above zero AND "
+                "TargetSpecificDamage CI above zero AND positive DiD "
+                "against every frozen control"
+            ),
+        }
+    return output
+
+
+def text_degeneration(text, window, fraction):
+    tokens = str(text).split()
+    if len(tokens) < 2 * int(window):
+        return False
+    grams = Counter(
+        tuple(tokens[index : index + int(window)])
+        for index in range(len(tokens) - int(window) + 1)
+    )
+    repeated = sum(count - 1 for count in grams.values() if count > 1)
+    return bool(repeated / max(1, len(grams)) > float(fraction))
+
+
+def generation_metrics(text, box, target_box, scale, truncated, token_count):
+    matches = list(BOX.finditer(text))
+    valid = box is not None and valid_box(box, scale)
+    parsed_iou = iou(box, target_box) if valid else 0.0
+    return {
+        "iou": float(parsed_iou),
+        "iou_at_least_0_5": bool(valid and parsed_iou >= 0.5),
+        "invalid_output": bool(box is None),
+        "box_missing": bool(not matches),
+        "box_multiple": bool(len(matches) > 1),
+        "truncated": bool(truncated),
+        "text_degenerate": text_degeneration(text, 8, 0.5),
+        "coordinate_mae_normalized": (
+            sum(abs(a - b) for a, b in zip(box, target_box)) / (4 * scale)
+            if valid
+            else None
+        ),
+        "generated_tokens": int(token_count),
+    }
+
+
+def summarize_generation(records, groups, conditions):
+    output = {}
+    by_condition = {}
+    for record in records:
+        for name, entry in (record.get("conditions") or {}).items():
+            group, _, condition = name.partition("|")
+            by_condition.setdefault((group, condition), []).append(entry)
+    for group in groups:
+        for condition in conditions:
+            rows = by_condition.get((group["name"], condition))
+            if not rows:
+                raise ValueError(
+                    f"generation coverage missing {group['name']}|{condition}"
+                )
+            output[f"{group['name']}|{condition}"] = _generation_summary(rows)
+    output["baseline"] = _generation_summary([record["baseline"] for record in records])
+    return output
+
+
+def _generation_summary(rows):
+    feasible = [row for row in rows if row.get("feasible", True)]
+
+    def mean(key):
+        values = [row[key] for row in feasible if row.get(key) is not None]
+        return float(np.mean(values)) if values else None
+
+    def fraction(key):
+        return float(np.mean([row[key] for row in feasible])) if feasible else None
+
+    return {
+        "samples": len(rows),
+        "n_feasible": len(feasible),
+        "n_unmatched": len(rows) - len(feasible),
+        "mean_iou": mean("iou"),
+        "mean_delta_iou": mean("delta_iou"),
+        "mean_damage_iou": mean("damage_iou"),
+        "iou_at_least_0_5_fraction": fraction("iou_at_least_0_5"),
+        "invalid_output_fraction": fraction("invalid_output"),
+        "box_missing_fraction": fraction("box_missing"),
+        "box_multiple_fraction": fraction("box_multiple"),
+        "truncated_fraction": fraction("truncated"),
+        "text_degenerate_fraction": fraction("text_degenerate"),
+        "mean_coordinate_mae_normalized": mean("coordinate_mae_normalized"),
+    }
+
+
+def generation_target_specific_damage(
+    records, groups, conditions=MATCHED_BACKGROUND_CONDITIONS
+):
+    """DamageIoU_target - mean matched-background DamageIoU, per group."""
+    output = {}
+    for group in groups:
+        name = group["name"]
+        target = np.full(len(records), np.nan)
+        backgrounds = np.full((len(records), len(conditions)), np.nan)
+        for index, record in enumerate(records):
+            entry = (record.get("conditions") or {}).get(f"{name}|target")
+            if entry is not None:
+                target[index] = entry["damage_iou"]
+            for column, condition in enumerate(conditions):
+                background = (record.get("conditions") or {}).get(f"{name}|{condition}")
+                if background is not None:
+                    backgrounds[index, column] = background["damage_iou"]
+        values = target - np.nanmean(backgrounds, axis=1)
+        values[~np.isfinite(target)] = np.nan
+        values[np.all(~np.isfinite(backgrounds), axis=1)] = np.nan
+        output[name] = values
+    return output
