+"""pruning.metrics：独立职责模块；原实验入口保留兼容导入。"""
+from __future__ import annotations
+
+import random
+from collections import Counter
+from .contracts import (
+    GROUP_UNION,
+)
+
+
+def cluster_bootstrap_ci(clusters, seed, replicates):
+    names = sorted(clusters)
+    if len(names) < 2:
+        return None
+    rng = random.Random(seed)
+    means = []
+    for _ in range(replicates):
+        draw = [rng.choice(names) for _ in names]
+        values = [value for name in draw for value in clusters[name]]
+        means.append(sum(values) / len(values))
+    means.sort()
+    low = means[int(0.025 * replicates)]
+    high = means[min(replicates - 1, int(0.975 * replicates))]
+    return [low, high]
+
+
+def verdict(interval, tolerance):
+    if interval is None:
+        return "undecided"
+    if interval[0] > tolerance:
+        return "holds"
+    if interval[1] < tolerance:
+        return "collapses"
+    return "undecided"
+
+
+def median(values):
+    ordered = sorted(values)
+    middle = len(ordered) // 2
+    if len(ordered) % 2:
+        return ordered[middle]
+    return (ordered[middle - 1] + ordered[middle]) / 2
+
+
+def summarize(records, plan):
+    spec = plan["spec"]
+    tolerance = float(spec["tolerance_delta_iou"])
+    seed, replicates = int(spec["bootstrap_seed"]), int(spec["bootstrap_replicates"])
+    names = [condition["name"] for condition in plan["conditions"]]
+    datasets = sorted({record["dataset"] for record in records})
+    output = {}
+    for name in names:
+        output[name] = {}
+        for group in ["all"] + datasets:
+            rows = [
+                record
+                for record in records
+                if record["condition"] == name
+                and (group == "all" or record["dataset"] == group)
+            ]
+            if not rows:
+                raise ValueError(f"incomplete condition/dataset matrix: {name}/{group}")
+            entry = dict(samples=len(rows))
+            for key in ("delta_iou", "delta_teacher_forced_iou", "delta_bbox_token_ce"):
+                clusters = {}
+                for record in rows:
+                    value = record["metrics"][key]
+                    if value is not None:
+                        clusters.setdefault(record["cluster"], []).append(value)
+                values = [
+                    value for value_list in clusters.values() for value in value_list
+                ]
+                entry[key + "_mean"] = sum(values) / len(values) if values else None
+                entry[key + "_median"] = median(values) if values else None
+                entry[key + "_ci95"] = (
+                    cluster_bootstrap_ci(clusters, seed, replicates) if values else None
+                )
+                entry[key + "_n"] = len(values)
+            entry["invalid_output_rate"] = sum(
+                record["metrics"]["invalid_output"] for record in rows
+            ) / len(rows)
+            entry["invalid_teacher_forced_output_rate"] = sum(
+                record["metrics"]["invalid_teacher_forced_output"] for record in rows
+            ) / len(rows)
+            entry["positive_delta_iou_fraction"] = sum(
+                record["metrics"]["delta_iou"] > 0 for record in rows
+            ) / len(rows)
+            entry["removed_heads"] = rows[0]["removed_heads"]
+            entry["removed_fraction"] = rows[0]["removed_heads"] / (
+                spec["num_layers"] * spec["num_heads"]
+            )
+            output[name][group] = entry
+    return output
+
+
+def paired_verdicts(summary, plan):
+    """逐条件判定；若存在 keep_only 条件，再补上分组对照（protected vs 同规模随机）。"""
+    tolerance = plan["spec"]["tolerance_delta_iou"]
+    output = {"tolerance_delta_iou": tolerance, "per_condition": {}, "per_group": {}}
+    for condition in plan["conditions"]:
+        if condition["mode"] == "baseline":
+            continue
+        interval = summary[condition["name"]]["all"]["delta_iou_ci95"]
+        output["per_condition"][condition["name"]] = dict(
+            mode=condition["mode"],
+            group=condition.get("group"),
+            support_box=condition.get("support_box"),
+            scope=condition.get("scope"),
+            per_layer=condition.get("per_layer"),
+            ci95=interval,
+            verdict=verdict(interval, tolerance),
+        )
+    if not any(name.startswith("keep_only:") for name in output["per_condition"]):
+        return output
+    groups = [name for name in plan["keep_groups"] if name != GROUP_UNION] + [
+        GROUP_UNION
+    ]
+    for name in groups:
+        item = {}
+        keep_only = summary[f"keep_only:{name}"]["all"]["delta_iou_ci95"]
+        random_keep = [
+            summary[f"keep_only_random:{name}:seed{seed}"]["all"]["delta_iou_ci95"]
+            for seed in plan["spec"]["random_seeds"]
+        ]
+        item["keep_only"] = dict(
+            ci95=keep_only,
+            verdict=verdict(keep_only, plan["spec"]["tolerance_delta_iou"]),
+        )
+        item["keep_only_random"] = [
+            dict(
+                seed=seed,
+                ci95=ci,
+                verdict=verdict(ci, plan["spec"]["tolerance_delta_iou"]),
+            )
+            for seed, ci in zip(plan["spec"]["random_seeds"], random_keep)
+        ]
+        item["extreme_point_supported"] = bool(
+            item["keep_only"]["verdict"] == "holds"
+            and all(entry["verdict"] != "holds" for entry in item["keep_only_random"])
+        )
+        item["scales"] = {}
+        for per_layer in plan["spec"]["removal_per_layer"]:
+            protected = [
+                summary[f"protected:{name}:perlayer{per_layer}:seed{seed}"]["all"][
+                    "delta_iou_ci95"
+                ]
+                for seed in plan["spec"]["random_seeds"]
+            ]
+            random_arm = [
+                summary[f"random:perlayer{per_layer}:seed{seed}"]["all"][
+                    "delta_iou_ci95"
+                ]
+                for seed in plan["spec"]["random_seeds"]
+            ]
+            protected_holds = [
+                verdict(ci, plan["spec"]["tolerance_delta_iou"]) == "holds"
+                for ci in protected
+            ]
+            random_holds = [
+                verdict(ci, plan["spec"]["tolerance_delta_iou"]) == "holds"
+                for ci in random_arm
+            ]
+            item["scales"][str(per_layer)] = dict(
+                protected_ci95=protected,
+                protected_holds=protected_holds,
+                random_ci95=random_arm,
+                random_holds=random_holds,
+                supported=bool(all(protected_holds) and not any(random_holds)),
+            )
+        item["supported_scales"] = sorted(
+            int(key) for key, value in item["scales"].items() if value["supported"]
+        )
+        output["per_group"][name] = item
+    return output
+
+
+def summary_integrity(records, plan):
+    conditions = {}
+    for condition in plan["conditions"]:
+        rows = [
+            record for record in records if record["condition"] == condition["name"]
+        ]
+        if not rows:
+            continue
+        deviations = Counter()
+        active_rows = 0
+        inactive_rows = 0
+        intervened_rows = 0
+        zero_intervention = 0
+        for record in rows:
+            state = record["output"]["prefix_state"]
+            if state["deviation"]:
+                deviations[state["deviation"]] += 1
+            active_rows += state["active_rows"]
+            inactive_rows += state["inactive_rows"]
+            has_attention_intervention = bool(
+                record["output"]["generation_readout_audit"]
+            ) or condition["mode"] in {
+                "keep_only",
+                "keep_only_random",
+                "protected",
+                "random",
+                "row_scope",
+            }
+            if (
+                has_attention_intervention
+                and condition["mode"] != "baseline"
+                and state["active_rows"] == 0
+            ):
+                zero_intervention += 1
+            if condition["mode"] != "baseline":
+                intervened_rows += sum(
+                    audit["rows"]
+                    for audit in record["output"]["generation_readout_audit"].values()
+                )
+        conditions[condition["name"]] = dict(
+            samples=len(rows),
+            mode=condition["mode"],
+            removed_heads=rows[0]["removed_heads"],
+            deviations=dict(deviations),
+            deviation_rate=sum(deviations.values()) / len(rows),
+            zero_intervention_samples=zero_intervention,
+            zero_intervention_rate=zero_intervention / len(rows),
+            active_rows=active_rows,
+            inactive_rows=inactive_rows,
+            intervened_generation_rows=intervened_rows,
+            invalid_output_rate=sum(
+                record["metrics"]["invalid_output"] for record in rows
+            )
+            / len(rows),
+            truncated_rate=sum(record["output"]["truncated"] for record in rows)
+            / len(rows),
+            teacher_forced_intervened_rows=sum(
+                audit["rows"]
+                for record in rows
+                for audit in record["output"]["readout_audit"].values()
+            ),
+        )
+    return dict(
+        schema="iploc-szy.keepset-pruning-integrity/v1",
+        sample_count=plan["sample_count"],
+        condition_count=len(plan["conditions"]),
+        keep_groups={name: len(heads) for name, heads in plan["keep_groups"].items()},
+        conditions=conditions,
+    )
