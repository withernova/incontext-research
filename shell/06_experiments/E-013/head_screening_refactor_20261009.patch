+    snapshots = {
+        "r001_frozen_input_snapshot.json": frozen_bytes,
+        "r001_summary_snapshot.json": summary_bytes,
+        "r001_manifest_sha256.txt": (
+            hashlib.sha256(manifest_bytes).hexdigest() + "\n"
+        ).encode(),
+        "resolved_r001_config.json": json.dumps(
+            config, ensure_ascii=False, indent=2
+        ).encode(),
