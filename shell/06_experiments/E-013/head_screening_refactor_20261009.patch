+"""target_background.generation：独立职责模块；原实验入口保留兼容导入。"""
+from __future__ import annotations
+
+import torch
+from ...prompting.coordinates import parse_box
+from ..artifacts import (
+    json_ready,
+)
+from ..localization import (
+    generation_prefix,
+    parse_generated_box,
+)
+from .contracts import (
+    GENERATION_RECORD_SCHEMA,
+)
+from .hooks import (
+    VisualEdgeRemovalHook,
+)
+from .metrics import (
+    generation_metrics,
+)
+
+
+def _generation_sample(
+    model,
+    collator,
+    sample,
+    tokenizer,
+    spans,
+    prepared,
+    generation_groups,
+    generation_conditions,
+    required,
+    assignment,
+    input_device,
+):
+    from transformers import GenerationConfig
+
+    labeled = collator([sample])
+    labels = labeled.pop("labels")
+    labeled.pop("metadata", None)
+    prefix, prompt_length = generation_prefix(labeled, labels, tokenizer, spans)
+    prefix = {key: value.to(input_device) for key, value in prefix.items()}
+    generation = GenerationConfig(
+        do_sample=False,
+        num_beams=1,
+        max_new_tokens=int(required["generation_max_new_tokens"]),
+        use_cache=True,
+        eos_token_id=model.generation_config.eos_token_id,
+        pad_token_id=model.generation_config.pad_token_id,
+        bos_token_id=model.generation_config.bos_token_id,
+    )
+    target_box = parse_box(sample["query_answer"])
+    if target_box is None:
+        raise ValueError("dataset query annotation cannot produce a target box")
+
+    with torch.inference_mode():
+        generated = model.generate(**prefix, generation_config=generation)
+        if not torch.equal(generated[:, :prompt_length], prefix["input_ids"]):
+            raise ValueError("generate returned an unexpected prompt prefix")
+        baseline_tokens = generated[0, prompt_length:].tolist()
+        if not baseline_tokens:
+            raise ValueError("generate returned no response")
+        eos = model.generation_config.eos_token_id
+        eos = [eos] if isinstance(eos, int) else list(eos or [])
+        baseline_truncated = (
+            len(baseline_tokens) >= int(required["generation_max_new_tokens"])
+            and baseline_tokens[-1] not in eos
+        )
+        baseline_text = tokenizer.decode(baseline_tokens, skip_special_tokens=True)
+        baseline_box = (
+            None
+            if baseline_truncated
+            else parse_generated_box(baseline_text, int(required["coordinate_scale"]))
+        )
+        baseline = generation_metrics(
+            baseline_text,
+            baseline_box,
+            target_box,
+            int(required["coordinate_scale"]),
+            baseline_truncated,
+            len(baseline_tokens),
+        )
+        baseline["text"] = baseline_text
+        conditions = {}
+        for group in generation_groups:
+            for condition in generation_conditions:
+                entry = prepared[group["name"]][condition]
+                key = f"{group['name']}|{condition}"
+                if entry["plan"] is None:
+                    conditions[key] = {
+                        "feasible": False,
+                        "iou": None,
+                        "damage_iou": None,
+                        "delta_iou": None,
+                        "truncated": None,
+                        "text": None,
+                        "coordinate_mae_normalized": None,
+                    }
+                    continue
+                hook = VisualEdgeRemovalHook(entry["plan"], spans[0], None, label=key)
+                with hook.installed(model):
+                    generated = model.generate(**prefix, generation_config=generation)
+                if not torch.equal(generated[:, :prompt_length], prefix["input_ids"]):
+                    raise ValueError(
+                        "hooked generate returned an unexpected prompt prefix"
+                    )
+                tokens = generated[0, prompt_length:].tolist()
+                if not tokens:
+                    raise ValueError("hooked generate returned no response")
+                hook.validate(len(tokens))
+                truncated = (
+                    len(tokens) >= int(required["generation_max_new_tokens"])
+                    and tokens[-1] not in eos
+                )
+                text = tokenizer.decode(tokens, skip_special_tokens=True)
+                box = (
+                    None
+                    if truncated
+                    else parse_generated_box(text, int(required["coordinate_scale"]))
+                )
+                metrics = generation_metrics(
+                    text,
+                    box,
+                    target_box,
+                    int(required["coordinate_scale"]),
+                    truncated,
+                    len(tokens),
+                )
+                metrics.update(
+                    {
+                        "feasible": True,
+                        "text": text,
+                        "box": box,
+                        "delta_iou": metrics["iou"] - baseline["iou"],
+                        "damage_iou": baseline["iou"] - metrics["iou"],
+                        "hook_audit": hook.audits,
+                    }
+                )
+                conditions[key] = metrics
+    return {
+        "schema": GENERATION_RECORD_SCHEMA,
+        **json_ready(assignment),
+        "prompt_tokens": int(prompt_length),
+        "intervention_rows": "all_query_rows_including_prefill",
+        "baseline": baseline,
+        "conditions": conditions,
+        "target_box": list(target_box),
+    }
