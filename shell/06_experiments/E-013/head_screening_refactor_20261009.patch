-def shift_box(box, delta, scale=1000):
-    """整体平移（只动 x），保持合法框：x1<x2 且落在 [0, scale]。"""
-    x1, y1, x2, y2 = box
-    x1s = min(max(0.0, x1 + delta), scale - 1.0)
-    x2s = min(max(x1s + 1.0, x2 + delta), float(scale))
-    return [x1s, y1, x2s, y2]
