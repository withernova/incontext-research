+"""pruning.plans：独立职责模块；原实验入口保留兼容导入。"""
+from __future__ import annotations
+
+import json
+import math
+from pathlib import Path
+from ..source_contracts import validate_source_run
+from .contracts import INPUT_IMAGE_MODES, ROW_SCOPES, SCHEMA, SUPPORT_BOX_MODES
+from .conditions import (
+    extreme_conditions,
+    input_image_conditions,
+    keepset_conditions,
+    load_keep_groups,
+    row_scope_conditions,
+    support_box_conditions,
+)
+
+
+def validate_spec(spec):
+    """复用 R-001 冻结输入/checkpoint 完整性检查，再换成 R-011 的保留组条件表。"""
+    if Path(spec["output_dir"]).exists():
+        raise ValueError("output directory already exists; refusing overwrite")
+    if not spec.get("random_seeds"):
+        raise ValueError("unresolved required config: random_seeds")
+    intervention = spec.get("intervention", "head_removal")
+    if intervention not in {"head_removal", "row_scope", "support_box", "input_image"}:
+        raise ValueError(
+            "intervention must be 'head_removal', 'row_scope', 'support_box' or 'input_image'"
+        )
+    if intervention == "input_image":
+        modes = spec.get("input_image_modes")
+        if (
+            not isinstance(modes, list)
+            or not modes
+            or any(mode not in INPUT_IMAGE_MODES for mode in modes)
+            or len(set(modes)) != len(modes)
+        ):
+            raise ValueError(
+                "input_image_modes must be unique members of INPUT_IMAGE_MODES"
+            )
+    if intervention == "support_box":
+        modes = spec.get("support_box_modes")
+        if (
+            not isinstance(modes, list)
+            or not modes
+            or any(mode not in SUPPORT_BOX_MODES for mode in modes)
+            or len(set(modes)) != len(modes)
+        ):
+            raise ValueError(
+                "support_box_modes must be unique members of SUPPORT_BOX_MODES"
+            )
+    if intervention == "row_scope":
+        scopes = spec.get("row_scopes")
+        if (
+            not isinstance(scopes, list)
+            or not scopes
+            or any(scope not in ROW_SCOPES for scope in scopes)
+            or len(set(scopes)) != len(scopes)
+        ):
+            raise ValueError("row_scopes must be unique members of ROW_SCOPES")
+    grid = spec.get("condition_grid", "full")
+    if grid not in {"full", "extreme_only"}:
+        raise ValueError("condition_grid must be 'full' or 'extreme_only'")
