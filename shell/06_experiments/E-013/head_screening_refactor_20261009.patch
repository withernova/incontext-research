+"""pruning.hooks：独立职责模块；原实验入口保留兼容导入。"""
+from __future__ import annotations
+
+from collections import Counter
+from contextlib import contextmanager
+from .contracts import (
+    FIELD_RUN,
+    ROW_SCOPES,
+)
+
+
+class BBoxPrefixTracker:
+    """只看已写出的前缀，判断当前解码行是否属于助手 bbox 括号区间（放宽口径）。"""
+
+    def __init__(self, tokenizer):
+        self.tokenizer = tokenizer
+        self.tokens = []
+        self.active = False
+        self.deviation = None
+        self.active_rows = 0
+        self.inactive_rows = 0
+        self.updates = 0
+
+    def reset(self):
+        self.tokens = []
+        self.active = False
+        self.deviation = None
+        self.updates = 0
+
+    def update(self, token_id):
+        self.updates += 1
+        self.tokens.append(int(token_id))
+        text = self.tokenizer.decode(self.tokens, skip_special_tokens=True)
+        opens, closes = text.count("["), text.count("]")
+        if self.deviation is not None:
+            self.active = False
+        elif opens == 0:
+            self.active = False
+            if closes:
+                self.deviation = "close_before_open"
+        elif opens > 1:
+            self.active = False
+            self.deviation = "multiple_open"
+        elif closes > 1:
+            self.active = False
+            self.deviation = "multiple_close"
+        elif closes == 1:
+            self.active = False
+            body = text.split("[", 1)[1].split("]", 1)[0]
+            if len(FIELD_RUN.findall(body)) != 4:
+                self.deviation = "field_count"
+        else:
+            self.active = True
+        if self.active:
+            self.active_rows += 1
+        else:
+            self.inactive_rows += 1
+        return self.active
+
+    def state(self):
+        return dict(
+            active_rows=self.active_rows,
+            inactive_rows=self.inactive_rows,
+            updates=self.updates,
+            deviation=self.deviation,
+            active=self.active,
+        )
+
+
+def text_embedding_module(model, vocab_size):
+    """定位唯一的文本 embedding：生成时每次前向都会经过它并带上 input_ids。"""
+    import torch
+
+    matches = [
+        module
+        for module in model.modules()
+        if isinstance(module, torch.nn.Embedding)
+        and int(module.num_embeddings) == int(vocab_size)
+    ]
+    if len(matches) != 1:
+        raise ValueError(
+            "cannot identify the single text embedding for prefix tracking "
+            "(matched %d modules with num_embeddings=%d)"
+            % (len(matches), int(vocab_size))
+        )
+    return matches[0]
+
+
+def scope_rows(scope, seq_len, answer_start, spans, prediction_rows=None):
+    """返回属于该来源组的行；约定行 r 预测 token r+1（与 bbox 行的 p-1 一致）。
+
+    ``spans`` 为两个图像视觉 token 跨度，(0)=reference，(1)=query。
+    """
+    if scope not in ROW_SCOPES:
+        raise ValueError(f"unknown row scope: {scope}")
+    if not isinstance(spans, (list, tuple)) or len(spans) != 2:
+        raise ValueError(
+            "row scopes require exactly one reference and one query image span"
+        )
+    rows = list(range(int(seq_len)))
+    if scope == "all":
+        return rows
+    if scope == "target_rows":
+        if prediction_rows is None:
+            raise ValueError("target_rows requires the bbox prediction rows")
+        return sorted({int(row) for row in prediction_rows})
+    if scope == "prompt":
+        return [row for row in rows if row <= int(answer_start) - 2]
+    if scope == "answer":
+        return [row for row in rows if row >= int(answer_start) - 1]
+    reference = set(range(int(spans[0][0]), int(spans[0][1])))
+    query = set(range(int(spans[-1][0]), int(spans[-1][1])))
+    image_positions = reference | query
+    image_rows = [row for row in rows if (row + 1) in image_positions]
+    if scope == "image":
+        return image_rows
+    if scope == "reference_image":
+        return [row for row in rows if (row + 1) in reference]
+    if scope == "query_image":
+        return [row for row in rows if (row + 1) in query]
+    if scope == "text":
+        return [row for row in rows if row not in image_rows]
+    raise ValueError(f"unhandled row scope: {scope}")
+
+
+def generation_mode(scope):
+    """生成阶段如何处理该来源组。"""
+    if scope in {"all", "text"}:
+        return "prefill_and_decode"
+    if scope in {"prompt", "image", "reference_image", "query_image"}:
+        return "prefill_only"
+    if scope == "answer":
+        return "decode_only"
+    if scope == "target_rows":
+        return "decode_tracker"
+    raise ValueError(f"unknown row scope: {scope}")
+
+
+class RowPlan:
+    """决定 teacher-forced 与生成两个阶段各干预哪些来源行。"""
+
+    def __init__(self, scope, spans, answer_start, prediction_rows=None):
+        self.scope = scope
+        self.spans = [(int(a), int(b)) for a, b in spans]
+        self.answer_start = int(answer_start)
+        self.prediction_rows = (
+            None if prediction_rows is None else [int(r) for r in prediction_rows]
+        )
+        self.mode = generation_mode(scope)
+
+    def teacher_rows(self, seq_len):
+        return scope_rows(
+            self.scope, seq_len, self.answer_start, self.spans, self.prediction_rows
+        )
+
+    def prefill_rows(self, prompt_length):
+        # prefill 只有 prompt（answer_start = prompt_length）：prompt 里没有 bbox 目标行，
+        # 其余组按同一分类规则得出（answer 组因此只含"预测第一个答案 token"的那一行）。
+        if self.scope == "target_rows":
+            return []
+        return scope_rows(self.scope, prompt_length, prompt_length, self.spans, None)
+
+    def decode_rows(self, active):
+        if self.mode not in {"prefill_and_decode", "decode_only", "decode_tracker"}:
+            return []
+        if self.mode == "decode_tracker":
+            return [0] if active else []
+        return [0]
+
+
+class FineReadoutZeroHook:
+    """只清零指定 head 在 bbox 读出位置 → query 图像视觉 key 上的注意力边。
+
+    ``rows`` 给出固定行时为 teacher-forced 口径（绝对预测行）；
+    ``rows is None`` 时为生成口径，由 ``tracker`` 决定当前行是否属于 bbox 括号区间。
+    """
+
+    def __init__(self, removed_heads, key_span, rows_fn, tracker=None):
+        self.removed = set(map(tuple, removed_heads))
+        self.key_span = (int(key_span[0]), int(key_span[1]))
+        if not callable(rows_fn):
+            raise ValueError(
+                "rows_fn must map (is_prefill, q_len, tracker_active) to source rows"
+            )
+        self.rows_fn = rows_fn
+        self.tracker = tracker
+        self.last_rows = []
+        self.audits = {}
+        self.layer_calls = Counter()
+        self.intervened_calls = 0
+        self.forward_calls = 0
+
+    @contextmanager
+    def installed(self, model):
+        import torch
+        from transformers.models.qwen3_vl import modeling_qwen3_vl as implementation
+
+        modules = [
+            m for m in model.modules() if m.__class__.__name__ == "Qwen3VLTextAttention"
+        ]
+        layers = {int(m.layer_idx) for m in modules}
+        if model.training or not modules or not {l for l, _ in self.removed} <= layers:
+            raise ValueError(
+                "hook requires eval Qwen3-VL text attention with all selected layers"
+            )
+        if any(m.config._attn_implementation != "eager" for m in modules):
+            raise ValueError("all text attention modules must use eager")
+        original = implementation.eager_attention_forward
+        start, stop = self.key_span
+        tracker = self.tracker
+
+        def capture(module, args, kwargs):
+            ids = kwargs.get("input_ids") if kwargs else None
+            if ids is None and args:
+                ids = args[0]
+            if ids is None or ids.dim() != 2 or ids.shape[0] != 1:
+                raise ValueError("cannot track generated tokens for the prefix rule")
+            # generate(use_cache=True)：第一个前向是 prefill，之后每个前向生成一个 token。
+            # 不假设解码时 input_ids 的长度（有的实现传单 token，有的传累积序列）。
+            self.forward_calls += 1
+            if self.forward_calls == 1:
+                tracker.reset()
+            else:
+                tracker.update(int(ids[0, -1]))
+            return None
+
+        def intercepted(
+            module, query, key, value, attention_mask, scaling, dropout=0.0, **kwargs
+        ):
+            output, attention = original(
+                module, query, key, value, attention_mask, scaling, dropout, **kwargs
+            )
+            if module.__class__.__name__ != "Qwen3VLTextAttention":
+                return output, attention
+            if query.shape[0] != 1 or dropout != 0:
+                raise ValueError("fine readout ablation requires batch=1 and dropout=0")
+            layer = int(module.layer_idx)
+            self.layer_calls[layer] += 1
+            selected = sorted(h for l, h in self.removed if l == layer)
+            if not selected:
+                return output, attention
+            is_prefill = attention.shape[-2] > 1
+            active = bool(tracker.active) if tracker is not None else False
+            planned = self.rows_fn(is_prefill, attention.shape[-2], active)
+            positions = [r for r in planned if 0 <= r < attention.shape[-2]]
+            if len(positions) != len(set(planned)):
+                raise ValueError("source row outside attention tensor")
+            self.last_rows = positions
+            if not positions:
+                return output, attention
+            if stop > attention.shape[-1]:
+                raise ValueError("key span outside attention tensor")
+            attention, output = attention.clone(), output.clone()
+            values = implementation.repeat_kv(value, module.num_key_value_groups)
+            for head in selected:
+                block = attention[:, head].float()[:, positions, start:stop]
+                if not bool(torch.isfinite(block).all()):
+                    raise ValueError("non-finite original attention")
+                mass = float(block.sum(-1).mean())
+                attention[:, head, positions, start:stop] = 0
+                av = torch.matmul(attention[:, head], values[:, head])
+                if not bool(torch.isfinite(av).all()):
+                    raise ValueError("intervened A@V is not finite")
+                output[:, :, head, :] = av
+                label = f"L{layer:02d}H{head:02d}"
+                audit = self.audits.setdefault(
+                    label, dict(rows=0, entries=0, removed_mass_sum=0.0)
+                )
