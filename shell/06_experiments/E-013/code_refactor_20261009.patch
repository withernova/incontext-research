+"""Quantized policy/anchor loading and optional DDP wrapping."""
+import os
+import torch
+import torch.distributed as dist
+from torch.nn.parallel import DistributedDataParallel as DDP
+
+
+def load_policy(config):
+    from iploc_szy.compat import ensure_torchvision_nms_schema
+    ensure_torchvision_nms_schema()
+    from transformers import AutoProcessor, Qwen3VLForConditionalGeneration, BitsAndBytesConfig
+    from peft import PeftModel, prepare_model_for_kbit_training
+    if not torch.cuda.is_available(): raise RuntimeError('CUDA is required for real training')
+    rank=int(os.environ.get('LOCAL_RANK',0)); world=int(os.environ.get('WORLD_SIZE',1))
+    torch.cuda.set_device(rank)
+    if world > 1:
+        if not dist.is_initialized(): dist.init_process_group('nccl')
+    kwargs=dict(dtype=torch.bfloat16,device_map={'':f'cuda:{rank}'},
+                local_files_only=True,attn_implementation='sdpa')
+    if config.get('load_in_4bit',True):
+        kwargs['quantization_config']=BitsAndBytesConfig(load_in_4bit=True,
+            bnb_4bit_quant_type='nf4',bnb_4bit_compute_dtype=torch.bfloat16,
+            bnb_4bit_use_double_quant=True)
+    base=Qwen3VLForConditionalGeneration.from_pretrained(config['model_path'],**kwargs)
+    if config.get('load_in_4bit',True):
+        base=prepare_model_for_kbit_training(base,use_gradient_checkpointing=False)
+    model=PeftModel.from_pretrained(base,config['adapter_path'],adapter_name='policy',is_trainable=True)
+    # Frozen SFT anchor, not the underlying base model with adapters disabled.
+    model.load_adapter(config['adapter_path'],adapter_name='anchor',is_trainable=False)
+    model.set_adapter('policy')
+    for name,p in model.named_parameters():
+        p.requires_grad_('lora_' in name and '.policy.' in name)
+    if not any(p.requires_grad for p in model.parameters()): raise RuntimeError('no trainable LoRA')
+    # Non-reentrant checkpointing supports frozen embeddings and LoRA gradients.
+    model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={'use_reentrant':False})
+    for module in model.modules():
+        if isinstance(module, torch.nn.Dropout): module.p = 0.
+    model.eval()
+    processor=AutoProcessor.from_pretrained(config['model_path'],local_files_only=True)
+    if world > 1:
+        model=DDP(model,device_ids=[rank],output_device=rank,find_unused_parameters=False,
+                  broadcast_buffers=False)
+    return model,processor
