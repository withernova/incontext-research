+"""Source-only experiment navigation, configuration migration and comparison."""
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+
+from iploc_szy.branching import load_experiment_config
+from iploc_szy.config import Config
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location('experiment_cli', ROOT / 'tools/experiments.py')
+CLI = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(CLI)
+PAIRS = [
+    (path, ROOT / 'configs/experiments/E-013' /
+     ('training' if path.parent.name == 'grpo' or
+      path.name == 'e013_qwen3vl8b_focus_confidence.py' else 'evaluation') / path.name)
+    for folder in ('grpo', 'sft')
+    for path in sorted((ROOT / 'configs' / folder).glob('e013_*.py'))
+]
+
+
+@pytest.mark.parametrize('old,new', PAIRS)
+def test_e013_legacy_paths_keep_effective_parameters_and_sources(old, new):
+    old_config = load_experiment_config(old)
+    new_config = load_experiment_config(new)
+    assert dict(old_config) == dict(new_config)
+    assert str(old.resolve()) in old_config.source_files
+    assert str(new.resolve()) in old_config.source_files
+    assert Config.fromfile(old).canonical_path == new.resolve()
+
+
+def test_moved_grpo_keeps_runtime_overrides_and_resolves_outside_repository(tmp_path, monkeypatch):
+    old = ROOT / 'configs/grpo/e013_multi3_rank_cf_branch.py'
+    new = ROOT / 'configs/experiments/E-013/training' / old.name
+    monkeypatch.chdir(tmp_path)
+    overrides = ['runtime.grpo.learning_rate=0.000123', 'named_run.run_name=source-check']
+    assert dict(load_experiment_config(old, overrides)) == dict(load_experiment_config(new, overrides))
+    assert load_experiment_config(new, overrides)['grpo']['learning_rate'] == 0.000123
+
+
+def test_recipe_listing_deduplicates_aliases_and_uses_source_ownership():
+    data = dict(configs=[
+        dict(config='configs/experiments/E-013/training/example.py', action='grpo', nproc=2),
+        dict(config='configs/grpo/e013_example.py', action='grpo', nproc=2,
+             canonical_config='configs/experiments/E-013/training/example.py'),
+        dict(config='configs/sft/shared.py', action='train', nproc=4),
+        dict(config='configs/_base_/base.py'),
+    ])
+    rows = CLI.recipes(data, 'E-013')
+    assert len(rows) == 1
+    assert rows[0]['aliases'] == ['configs/grpo/e013_example.py']
+    assert len(CLI.recipes(data)) == 2
+    assert CLI.owner('configs/sft/e011_example.py') == 'E-011'
+    assert CLI.owner('configs/sft/shared.py') == 'shared'
+
+
+def test_specialized_experiments_are_listed_with_observed_shells_not_guessed_workers():
+    target = 'configs/experiments/E-012/analysis/probe.py'
+    alias = 'configs/head_screening/e012_probe.py'
+    data = dict(configs=[dict(config=target), dict(config=alias, canonical_config=target)],
+                shells=[dict(shell='tools/run/analysis/probe.sh', tier='experiment analysis',
+                             targets=[alias]),
+                        dict(shell='tools/run/old_probe.sh', tier='compatibility alias',
+                             targets=['tools/run/analysis/probe.sh'])])
+    rows = CLI.recipes(data, 'E-012')
+    assert len(rows) == 1
+    assert rows[0]['action'] == 'specialized' and rows[0]['processes'] is None
+    assert rows[0]['entrypoints'] == ['tools/run/analysis/probe.sh']
+
+
+def test_specialized_show_reads_config_without_opening_run_references(tmp_path, capsys):
+    path = tmp_path / 'probe.py'
+    path.write_text("run_spec=dict(source_run_dir='/missing/run', output_dir='/missing/output')\n")
+    assert CLI.main(['show', str(path)]) == 0
+    plan = json.loads(capsys.readouterr().out)
+    assert plan['action'] == 'specialized'
+    assert plan['worker_command'] is None and plan['nproc_per_node'] is None
+    assert plan['resolved_config']['run_spec']['source_run_dir'] == '/missing/run'
+
+
+def test_show_never_allocates_output_checks_artifacts_or_builds_models(tmp_path, monkeypatch, capsys):
+    from iploc_szy import MODELS
+    def forbidden(*args, **kwargs):
+        pytest.fail('source navigation must not execute tasks or inspect data')
+    monkeypatch.setattr(MODELS, 'build', forbidden)
+    monkeypatch.setattr('iploc_szy.run_management.prepare_named_run', forbidden)
+    monkeypatch.setattr('iploc_szy.launching.validate_inputs', forbidden)
+    path = tmp_path / 'recipe.py'
+    output = tmp_path / 'unallocated'
+    path.write_text(f"launch=dict(action='train',nproc_per_node=1)\n"
+                    f"work_dir={str(output)!r}\nmodel=dict(type='missing')\n"
+                    "input_artifacts=[dict(path='/missing/asset',sha256='missing')]\n"
+                    "runner=dict(max_steps=1)\n")
+    assert CLI.main(['show', str(path), '--cfg-options', 'runner.max_steps=7']) == 0
+    result = json.loads(capsys.readouterr().out)
+    assert result['resolved_config']['runner']['max_steps'] == 7
+    assert result['source_configs'] == [str(path.resolve())]
+    assert not output.exists()
+
+
+def test_diff_distinguishes_missing_none_and_nested_changes():
+    assert CLI.differences(dict(a=None, nested=dict(lr=1), removed=7),
+                           dict(a=None, nested=dict(lr=2), added=None)) == [
+        dict(key='added', change='added', right=None),
+        dict(key='nested.lr', change='changed', left=1, right=2),
+        dict(key='removed', change='removed', left=7),
+    ]
+
+
+def test_cli_diff_legacy_and_canonical_is_empty(capsys):
+    old = ROOT / 'configs/grpo/e013_multi3_rank_cf_branch.py'
+    new = ROOT / 'configs/experiments/E-013/training' / old.name
+    assert CLI.main(['diff', str(old), str(new)]) == 0
+    assert json.loads(capsys.readouterr().out) == []
+
+
+def test_cli_list_runs_from_another_directory_without_installing_snapshot(tmp_path):
+    result = subprocess.run(
+        [sys.executable, str(ROOT / 'tools/experiments.py'), 'list',
+         '--experiment', 'E013', '--json'], cwd=tmp_path,
+        capture_output=True, text=True, check=True)
+    rows = json.loads(result.stdout)
+    assert len(rows) == 12
+    assert {row['action'] for row in rows} == {'train', 'grpo', 'evaluate'}
+    assert all(row['config'].startswith('configs/experiments/E-013/') for row in rows)
+    assert all(len(row['aliases']) == 1 for row in rows)
+
+
+@pytest.mark.parametrize('value', ['E013', 'E-013', 'e-013'])
+def test_experiment_filter_normalizes(value):
+    assert CLI.experiment_id(value) == 'E-013'
+
+
+def test_invalid_experiment_filter_is_rejected():
+    with pytest.raises(argparse.ArgumentTypeError):
+        CLI.experiment_id('013')
