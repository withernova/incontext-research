+"""Model-free GRPO configuration, pair and image checks."""
+import math
+from pathlib import Path
+from .data import load_rows, load_collage_rows
+
+
+def inspect_config(config):
+    required = ('model_path','adapter_path','manifest','output_dir')
+    if any(not config.get(k) for k in required): raise ValueError('missing required path')
+    for name in ('model_path','adapter_path'):
+        if not Path(config[name]).is_dir(): raise ValueError('missing '+name)
+    if not (Path(config['adapter_path'])/'adapter_config.json').is_file():
+        raise ValueError('adapter_path must be the adapter directory')
+    if Path(config['output_dir']).exists(): raise ValueError('output_dir already exists')
+    for key in ('max_new_tokens','max_pixels'):
+        if type(config.get(key)) is not int or config[key] < 1: raise ValueError('invalid '+key)
+    if config.get('epochs') is not None and (type(config['epochs']) is not int or config['epochs'] < 1):
+        raise ValueError('invalid epochs')
+    if config.get('epochs') is None and (type(config.get('steps')) is not int or config['steps'] < 1):
+        raise ValueError('steps or epochs is required')
+    if type(config.get('group_size')) is not int or config['group_size'] < 2:
+        raise ValueError('group_size must be at least two')
+    if config.get('beta',0.04) < 0 or not 0 < config.get('clip',0.2) < 1:
+        raise ValueError('invalid GRPO coefficients')
+    if config.get('learning_rate',1e-6) <= 0: raise ValueError('invalid learning_rate')
+    cf=config.get('counterfactual',{})
+    if not isinstance(cf,dict): raise ValueError('counterfactual configuration must be a dict')
+    for key,default in (('weight',0.),('beta',0.1),('min_best_iou',0.5),('min_reward_gain',0.)):
+        value=cf.get(key,default)
+        if not isinstance(value,(int,float)) or isinstance(value,bool) or not math.isfinite(value):
+            raise ValueError('invalid counterfactual '+key)
+        if ((key in ('weight','min_reward_gain') and value < 0)
+                or (key == 'beta' and not 0 < value <= 1)
+                or (key == 'min_best_iou' and not 0 <= value <= 1)):
+            raise ValueError('invalid counterfactual '+key)
+    if cf.get('weight',0) > 0 and config.get('prompt_protocol') not in (
+            'focus_multi3_instances_v1', 'focus_multi3_instances_spatial_v2'):
+        raise ValueError('score counterfactual requires the three-candidate prompt')
+    rows=load_rows(config['manifest'],'train')
+    collage_manifest=config.get('collage_manifest')
+    if collage_manifest:
+        if config.get('prompt_protocol') not in (
+                'focus_multi3_instances_v1', 'focus_multi3_instances_spatial_v2'):
+            raise ValueError('collage requires the multi-candidate prompt')
+        rows += load_collage_rows(collage_manifest, config['manifest'], rows)
+    for r in rows:
+        for key in ('query_image','reference_image'):
+            if not Path(r[key]).is_file(): raise ValueError('missing image: '+r[key])
+    return rows
