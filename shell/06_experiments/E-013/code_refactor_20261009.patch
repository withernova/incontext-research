+#!/usr/bin/env python3
+"""查看实验配方、最终配置和参数差异；只读取源码，不分配运行目录。"""
+import argparse
+import json
+from pathlib import Path
+import re
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from iploc_szy.branching import load_experiment_config
+from iploc_szy.config import Config
+from iploc_szy.launching import inspect_plan
+from tools.audit_entrypoints import inventory
+
+
+def experiment_id(value):
+    match = re.fullmatch(r'E-?(\d{3})', value.upper())
+    if not match:
+        raise argparse.ArgumentTypeError('实验编号格式为 E-013 或 E013')
+    return 'E-' + match[1]
+
+
+def owner(path):
+    parts = Path(path).parts
+    if 'experiments' in parts:
+        index = parts.index('experiments') + 1
+        if index < len(parts) and re.fullmatch(r'E-\d{3}', parts[index]):
+            return parts[index]
+    match = re.match(r'e(\d{3})_', Path(path).name, re.I)
+    return 'E-' + match[1] if match else 'shared'
+
+
+def recipes(data, selected=None):
+    """Canonical source configs with aliases attached, grouped by explicit ownership."""
+    aliases = {}
+    canonical = {}
+    for row in data['configs']:
+        if row.get('canonical_config'):
+            aliases.setdefault(row['canonical_config'], []).append(row['config'])
+            canonical[row['config']] = row['canonical_config']
+    entrypoints = {}
+    for shell in data.get('shells', []):
+        if shell['tier'] == 'compatibility alias':
+            continue
+        for target in shell['targets']:
+            entrypoints.setdefault(canonical.get(target, target), set()).add(shell['shell'])
+    rows = []
+    for row in data['configs']:
+        entries = sorted(entrypoints.get(row['config'], []))
+        if row.get('canonical_config') or ('action' not in row and not entries):
+            continue
+        experiment = owner(row['config'])
+        if selected is None or experiment == selected:
+            rows.append(dict(experiment=experiment, config=row['config'],
+                             action=row.get('action', 'specialized'), processes=row.get('nproc'),
+                             entrypoints=entries,
+                             aliases=sorted(aliases.get(row['config'], []))))
+    return sorted(rows, key=lambda row: (row['experiment'], row['action'], row['config']))
+
+
+def resolve(path, options=()):
+    path = Path(path).resolve()
+    source = Config.fromfile(path)
+    config = load_experiment_config(path, options)
+    if config.get('branch') or config.get('launch'):
+        plan = inspect_plan(config, path, options)
+    else:
+        plan = dict(config=str(path), action='specialized', nproc_per_node=None,
+                    worker_command=None, resolved_config=dict(config),
+                    cfg_options=list(options),
+                    allocation='专项配置：启动接口见登记的 Shell 或对应 Python 工具',
+                    input_checks='未读取输入产物')
+    plan['canonical_config'] = str(source.canonical_path)
+    plan['source_configs'] = list(config.source_files)
+    return plan
+
+
+def differences(left, right, prefix=''):
+    """Report additions/removals explicitly; None remains a real configured value."""
+    result = []
+    for key in sorted(set(left) | set(right)):
+        name = prefix + str(key)
+        if key not in left:
+            result.append(dict(key=name, change='added', right=right[key]))
+        elif key not in right:
+            result.append(dict(key=name, change='removed', left=left[key]))
+        elif isinstance(left[key], dict) and isinstance(right[key], dict):
+            result.extend(differences(left[key], right[key], name + '.'))
+        elif left[key] != right[key]:
+            result.append(dict(key=name, change='changed', left=left[key], right=right[key]))
+    return result
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    commands = parser.add_subparsers(dest='command', required=True)
+    listing = commands.add_parser('list', help='按实验查看 canonical 配方和兼容别名')
+    listing.add_argument('--experiment', type=experiment_id)
+    listing.add_argument('--json', action='store_true')
+    showing = commands.add_parser('show', help='查看最终配置和配置来源，不检查输入产物')
+    showing.add_argument('config')
+    showing.add_argument('--cfg-options', nargs='*', default=[])
+    comparing = commands.add_parser('diff', help='比较两份合并后的源码配置，不读取运行结果')
+    comparing.add_argument('left')
+    comparing.add_argument('right')
+    args = parser.parse_args(argv)
+    if args.command == 'list':
+        rows = recipes(inventory(ROOT), args.experiment)
+        if args.experiment and not rows:
+            parser.error('该实验没有登记在源码目录中的可执行配方')
+        if args.json:
+            print(json.dumps(rows, ensure_ascii=False, indent=2))
+        else:
+            print('实验\t任务\t进程数\t配置\t专项入口')
+            for row in rows:
+                print('{}\t{}\t{}\t{}\t{}'.format(
+                    row['experiment'], row['action'],
+                    row['processes'] if row['processes'] is not None else '—',
+                    row['config'], ', '.join(row['entrypoints']) or 'tools/run.sh'))
+        return 0
+    if args.command == 'show':
+        payload = resolve(args.config, args.cfg_options)
+    else:
+        left = resolve(args.left)['resolved_config']
+        right = resolve(args.right)['resolved_config']
+        payload = differences(left, right)
+    print(json.dumps(payload, ensure_ascii=False, indent=2, default=str))
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
