+named_run = dict(
+    run_name='multi3-collage-coverage-grpo-lr8e5-3ep',
+    notes='从置信度SFT初始化；原始正负对与拼图A/B对等量混合。前两框按空间顺序覆盖左右实例；Reference切换决定置信度与最终选择。')
+runtime = dict(grpo=dict(
