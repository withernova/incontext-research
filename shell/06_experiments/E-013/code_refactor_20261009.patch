+"""Completion-only sampling and log-probability replay shared by GRPO experiments."""
+import torch
+from .objective import selected_log_probs
+
+
+def reset_positions(model):
+    # Qwen3-VL stores rope_deltas during generation. Replay must recompute them.
+    if hasattr(model, 'module'):
+        model = model.module
+    base = model.get_base_model() if hasattr(model, 'get_base_model') else model
+    for module in base.modules():
+        if hasattr(module, 'rope_deltas'):
+            module.rope_deltas = None
+
+
+def completion_logp(model, batch, ids):
+    inputs = dict(batch)
+    length = batch['input_ids'].shape[1]
+    inputs['input_ids'] = ids
+    inputs['attention_mask'] = torch.ones_like(ids)
+    inputs.pop('token_type_ids', None)
+    reset_positions(model)
+    # Project only completion predictors into the large vocabulary.
+    keep = ids.shape[1] - length + 1
+    logits = model(**inputs, use_cache=False, logits_to_keep=keep).logits
+    return selected_log_probs(logits, ids[:, length-1:], 1)
+
+
+def rollout(model, processor, batch, max_new_tokens):
+    from transformers import GenerationConfig
+    reset_positions(model)
+    eos = model.generation_config.eos_token_id
+    if eos is None: eos = processor.tokenizer.eos_token_id
+    eos_ids = [eos] if isinstance(eos, int) else eos
+    if not eos_ids: raise ValueError('EOS ids are required')
+    # Fresh config: no hidden top-k, repetition penalty, or checkpoint warpers.
+    pad_token_id = processor.tokenizer.pad_token_id
+    config = GenerationConfig(do_sample=True, temperature=1., top_p=1., top_k=0,
+        max_new_tokens=max_new_tokens, eos_token_id=eos_ids,
+        pad_token_id=eos_ids[0] if pad_token_id is None else pad_token_id, use_cache=True)
+    with torch.no_grad():
+        ids = model.generate(**batch, generation_config=config,
+                             use_model_defaults=False, temperature=1., top_p=1., top_k=0)
+    length = batch['input_ids'].shape[1]
+    completion = ids[0,length:]
+    positions = [i for i,t in enumerate(completion.tolist()) if t in eos_ids]
+    terminated = bool(positions)
+    if terminated:
+        ids = ids[:,:length+positions[0]+1]
+        text_ids = ids[0,length:-1]
+    else:
+        text_ids = completion
+    # Keep non-EOS special tokens visible so the strict parser can reject them.
+    text = processor.tokenizer.decode(text_ids, skip_special_tokens=False)
+    return ids, text, terminated
